{
  "$id": "survey-v2-h1-exposure-adjudication-request-schema-v1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "contract_version": {
      "const": "survey-v2-h1-exposure-adjudication-contract-v1.0.0"
    },
    "custody_attestation": {
      "additionalProperties": false,
      "properties": {
        "birth_data_absent": {
          "const": true
        },
        "candidate_and_true_state_data_absent": {
          "const": true
        },
        "direct_identifiers_removed": {
          "const": true
        },
        "evidence_crosswalk_withheld": {
          "const": true
        },
        "evidence_ids_unique_and_opaque": {
          "const": true
        },
        "h1_content_absent": {
          "const": true
        },
        "identity_removed": {
          "const": true
        },
        "owner_adjudication_absent": {
          "const": true
        },
        "participant_material_absent": {
          "const": true
        },
        "personal_chart_values_absent": {
          "const": true
        },
        "prediction_score_rank_absent": {
          "const": true
        }
      },
      "required": [
        "identity_removed",
        "direct_identifiers_removed",
        "birth_data_absent",
        "personal_chart_values_absent",
        "candidate_and_true_state_data_absent",
        "prediction_score_rank_absent",
        "participant_material_absent",
        "h1_content_absent",
        "owner_adjudication_absent",
        "evidence_crosswalk_withheld",
        "evidence_ids_unique_and_opaque"
      ],
      "type": "object"
    },
    "evidence_packet_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "evidence_units": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "exposure_modes": {
                  "contains": {
                    "const": "none_declared"
                  }
                }
              },
              "required": [
                "exposure_modes"
              ]
            },
            "then": {
              "properties": {
                "exposure_modes": {
                  "maxItems": 1
                }
              }
            }
          }
        ],
        "properties": {
          "evidence_id": {
            "pattern": "^H1E-[A-Za-z0-9_-]{16,}$",
            "type": "string"
          },
          "exposure_modes": {
            "items": {
              "enum": [
                "chart_generated_or_seen",
                "personal_reading",
                "casual_discussion",
                "book_course_or_training",
                "reader_teacher_coach_or_practice",
                "mechanics_calculation_mapping_or_software",
                "identity_or_worldview_use",
                "h1_source_or_derivation_use",
                "astrology_semantic_or_technical_use",
                "none_declared"
              ]
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "fact_kind": {
            "enum": [
              "exposure_event",
              "semantic_capability",
              "technical_capability",
              "identity_or_professional_role",
              "h1_derivation_process",
              "non_exposure_or_non_use_attestation",
              "timing_fact"
            ]
          },
          "redacted_statement": {
            "minLength": 1,
            "type": "string"
          },
          "redacted_statement_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "source_kind": {
            "enum": [
              "author_attestation",
              "contemporaneous_record",
              "independent_attestation",
              "redacted_document_excerpt",
              "model_context_manifest",
              "h1_process_record"
            ]
          },
          "temporal_relation": {
            "enum": [
              "before_h1_authorship",
              "during_h1_authorship",
              "spans_h1_authorship",
              "after_h1_content_freeze",
              "unknown"
            ]
          }
        },
        "required": [
          "evidence_id",
          "source_kind",
          "fact_kind",
          "temporal_relation",
          "exposure_modes",
          "redacted_statement",
          "redacted_statement_sha256"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "h1_artifact_id": {
      "pattern": "^H1A-[A-Za-z0-9_-]{16,}$",
      "type": "string"
    },
    "h1_content_freeze_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "output_schema_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "prompt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "request_id": {
      "pattern": "^H1R-[A-Za-z0-9_-]{16,}$",
      "type": "string"
    },
    "schema_version": {
      "const": "survey-v2-h1-exposure-adjudication-request-schema-v1.0.0"
    },
    "subject_kind": {
      "enum": [
        "human_author",
        "model_context_author"
      ]
    },
    "subject_role": {
      "enum": [
        "interpretation_author",
        "construct_author"
      ]
    }
  },
  "required": [
    "schema_version",
    "contract_version",
    "contract_sha256",
    "prompt_sha256",
    "output_schema_sha256",
    "request_id",
    "subject_role",
    "subject_kind",
    "h1_artifact_id",
    "h1_content_freeze_sha256",
    "evidence_packet_sha256",
    "evidence_units",
    "custody_attestation"
  ],
  "type": "object"
}
