                  "OVERLAP_UNKNOWN",
                  "QUARANTINE_UNKNOWN",
                  "EVIDENCE_CONFLICT",
                  "EVIDENCE_INSUFFICIENT",
                  "MODEL_TRAINING_AUDITED_ONTOLOGY_ABSENT",
                  "MODEL_TRAINING_UNKNOWN_OR_UNAUDITABLE",
