{
  "$id": "survey-v2-classifier-output-schema-v1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "survey-v2-human-measurement-scoring-contract-v1.0.0"
    },
    "request_id": {
      "minLength": 1,
      "type": "string"
    },
    "results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "candidate_blind_attestation": {
            "type": "boolean"
          },
          "childhood_continuity": {
            "enum": [
              "present_since_childhood",
              "adult_emergent",
              "changed_form",
              "not_present",
              "unknown",
              "not_applicable"
            ]
          },
          "confidence": {
            "enum": [
              0.0,
              0.5,
              0.65,
              0.8,
              0.95
            ]
          },
          "context_notes": {
            "type": "string"
          },
          "counterevidence_span_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "evidence_span_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "field_id": {
            "minLength": 1,
            "type": "string"
          },
          "forced_choice": {
            "const": false
          },
          "job_id": {
            "minLength": 1,
            "type": "string"
          },
          "minimum_evidence_passed": {
            "type": "boolean"
          },
          "primary_archetype": {
            "type": [
              "string",
              "null"
            ]
          },
          "secondary_archetypes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "classified",
              "mixed",
              "other",
              "insufficient_evidence",
              "unclassifiable"
            ]
          }
        },
        "required": [
          "job_id",
          "field_id",
          "status",
          "primary_archetype",
          "secondary_archetypes",
          "confidence",
          "minimum_evidence_passed",
          "evidence_span_ids",
          "counterevidence_span_ids",
          "context_notes",
          "childhood_continuity",
          "forced_choice",
          "candidate_blind_attestation"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "survey-v2-classifier-output-schema-v1.0.0"
    },
    "top_level_status": {
      "enum": [
        "completed",
        "forbidden_input"
      ]
    }
  },
  "required": [
    "schema_version",
    "contract_version",
    "request_id",
    "top_level_status",
    "results"
  ],
  "type": "object"
}
