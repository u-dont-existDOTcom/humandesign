{
  "schema": "ZIWEI_FOURTEEN_MAJOR_STARS_SOURCE_CONDITIONAL_RHYME_V1",
  "original_source_witness": {
    "original_Vol2_revision_oldid": 1963110,
    "original_raw_SHA256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
    "original_14_star_verse_exact": "紫微天机逆行旁，隔一阳武天同当，又隔二位廉贞地，空三复见紫微郎，\n天府太阴与贪狼，巨门天相及天梁，七杀空三破军位，八星顺数细推详。",
    "original_14_star_verse_sha256": "b4f431d4c22b7f251ab167f801b51c5be008bf6282dcb368da750f1432178634",
    "verse_start_original_codepoint_offset": 810,
    "verse_start_original_utf8_byte_offset": 2036,
    "original_worked_example_exact": "如甲生人安命在寅却起甲己之年丙为首，是丙寅丁卯炉中火，却去火局寻某日生期起紫微帝王，\n如是正月初一生者是火局，酉宫起初一日，就从酉宫起紫微，数无差迟，若错了则失之毫厘，差之千里矣。",
    "original_worked_example_sha256": "34568fe3e7603a15d78c74e2d762ddafb54db65d7cda815614324df593869481",
    "modern_secondary_explainer_for_crossreading_only": "https://xingge.tw/en/quanshu/anming-zhuxing",
    "source_ancient_Ming_physical_edition_verified": false,
    "expert_textual_critical_collation_complete": false
  },
