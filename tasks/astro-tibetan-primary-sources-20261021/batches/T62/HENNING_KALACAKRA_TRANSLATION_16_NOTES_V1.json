      },
      "key": "model_accuracy_historical_polemic",
      "paraphrase": "The Vimalaprabhā translation criticizes astronomical models that obscure accurate solar positions, on which its planetary longitudes depend; cultural rhetoric is not scientific evidence.",
      "kind": "source-only",
      "human_validated": false
    },
    {
