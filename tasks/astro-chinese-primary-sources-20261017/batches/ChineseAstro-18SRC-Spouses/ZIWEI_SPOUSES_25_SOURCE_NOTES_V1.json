    {
      "id": "ZWD-R0771",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-18SRC-Spouses",
      "source_original_online_revision": 1963110,
      "full_source_wikitext_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "source_kind": "SOURCE_HISTORICAL_TEXT_LINE",
      "original_source_Chinese_exact_line": "紫微晚聘谐老性刚，天府同谐老，天相同年少，破军同刑剋，加羊陀火铃亦刑，贪狼同有吉星免刑。",
      "quote_sha256": "e0ca529254285ec62aaf088a037eb5fc2d7be6d7405807bbe4454284d8c512ac",
      "quote_UTF8_bytes": 132,
      "absolute_codepoint_offset": 38255,
      "absolute_UTF8_byte_offset": 76907,
      "relative_section_codepoint_offset": 17,
      "source_historic_gender_and_marriage_claims_not_advice": true,
      "original_printed_early_edition_authenticated": false,
      "human_blind_predictive_validation_count": 0,
      "runtime_astrological_rule_promoted": false
    },
    {
      "id": "ZWD-R0772",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-18SRC-Spouses",
      "source_original_online_revision": 1963110,
      "full_source_wikitext_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "source_kind": "SOURCE_HISTORICAL_TEXT_LINE",
      "original_source_Chinese_exact_line": "天机宜年少刚强之，妻可配夫宜长，加羊陀火铃主生离，晚娶吉，天梁同宜年长，太阴同内助美容。",
      "quote_sha256": "6e09a133d5993a23fe974730e9ca9df9d7ab3b2e27b0519dbc38b920a2c93af0",
      "quote_UTF8_bytes": 132,
      "absolute_codepoint_offset": 38302,
      "absolute_UTF8_byte_offset": 77042,
      "relative_section_codepoint_offset": 64,
      "source_historic_gender_and_marriage_claims_not_advice": true,
      "original_printed_early_edition_authenticated": false,
      "human_blind_predictive_validation_count": 0,
      "runtime_astrological_rule_promoted": false
    },
    {
      "id": "ZWD-R0773",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-18SRC-Spouses",
      "source_original_online_revision": 1963110,
      "full_source_wikitext_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "source_kind": "SOURCE_HISTORICAL_TEXT_LINE",
      "original_source_Chinese_exact_line": "太阳庙旺迟娶吉，早娶克，因妻得贵，与天梁同加左右招贤明之妻，",
      "quote_sha256": "80ca4c8b96d1e171d17d82901ce0baa6334a2650549cceb7fae5ba92c6526ca7",
      "quote_UTF8_bytes": 90,
      "absolute_codepoint_offset": 38349,
      "absolute_UTF8_byte_offset": 77177,
      "relative_section_codepoint_offset": 111,
      "source_historic_gender_and_marriage_claims_not_advice": true,
      "original_printed_early_edition_authenticated": false,
      "human_blind_predictive_validation_count": 0,
      "runtime_astrological_rule_promoted": false
    },
    {
      "id": "ZWD-R0774",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-18SRC-Spouses",
      "source_original_online_revision": 1963110,
      "full_source_wikitext_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "source_kind": "SOURCE_WRAPPED_CONTINUATION_OF_PREVIOUS_SOLAR_ENTRY",
      "original_source_Chinese_exact_line": "太阴同内助，巨门同无羊陀火铃空劫不克，有此四杀，反空劫定克，遇耗非礼成婚。",
      "quote_sha256": "26dfa56eb9b0df37dc2c37101da64b6f8081c46a3139292940d50c0d6bf2e00c",
      "quote_UTF8_bytes": 111,
      "absolute_codepoint_offset": 38380,
      "absolute_UTF8_byte_offset": 77268,
      "relative_section_codepoint_offset": 142,
      "source_historic_gender_and_marriage_claims_not_advice": true,
      "original_printed_early_edition_authenticated": false,
      "human_blind_predictive_validation_count": 0,
      "runtime_astrological_rule_promoted": false
    },
    {
      "id": "ZWD-R0775",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-18SRC-Spouses",
      "source_original_online_revision": 1963110,
      "full_source_wikitext_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "source_kind": "SOURCE_HISTORICAL_TEXT_LINE",
      "original_source_Chinese_exact_line": "武曲背克宜迟娶，同年夫妇也相当，加吉星因妻得财，凶娶因妻去产，贪狼同招迟无刑七杀同克二三妻，加羊陀火铃空劫更克。",
      "quote_sha256": "6e3fca13b9e8c8c52ea1bdac29c80868d8cc7d5cfd9d0d63d17260c921733a8a",
      "quote_UTF8_bytes": 168,
      "absolute_codepoint_offset": 38420,
      "absolute_UTF8_byte_offset": 77382,
      "relative_section_codepoint_offset": 182,
      "source_historic_gender_and_marriage_claims_not_advice": true,
      "original_printed_early_edition_authenticated": false,
      "human_blind_predictive_validation_count": 0,
      "runtime_astrological_rule_promoted": false
    },
    {
      "id": "ZWD-R0776",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-18SRC-Spouses",
      "source_original_online_revision": 1963110,
      "full_source_wikitext_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "source_kind": "SOURCE_HISTORICAL_TEXT_LINE",
      "original_source_Chinese_exact_line": "天同迟娶谐老，夫宜长妻宜少，加四杀欠和生离，巨门同加四杀亦克，太阴同助美容，天梁同极美夫妇。",
      "quote_sha256": "8c26ab4dba1dfc9f0900d3cbadae2366a67823df37c5ab115f0a9c5e0d01e544",
      "quote_UTF8_bytes": 138,
      "absolute_codepoint_offset": 38479,
      "absolute_UTF8_byte_offset": 77553,
      "relative_section_codepoint_offset": 241,
      "source_historic_gender_and_marriage_claims_not_advice": true,
      "original_printed_early_edition_authenticated": false,
      "human_blind_predictive_validation_count": 0,
      "runtime_astrological_rule_promoted": false
    },
    {
      "id": "ZWD-R0777",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-18SRC-Spouses",
      "source_original_online_revision": 1963110,
      "full_source_wikitext_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "source_kind": "SOURCE_HISTORICAL_TEXT_LINE",
      "original_source_Chinese_exact_line": "廉贞三度作新郎，即贪狼同愈克七杀同亦刑，且欠和加，羊陀火铃主生离，府谐老性刚者无克。",
      "quote_sha256": "831baa3189e05122c04f5ffbe39f0dde81265adeb9bd2bec7d76e9778829e252",
      "quote_UTF8_bytes": 126,
      "absolute_codepoint_offset": 38528,
      "absolute_UTF8_byte_offset": 77694,
      "relative_section_codepoint_offset": 290,
      "source_historic_gender_and_marriage_claims_not_advice": true,
      "original_printed_early_edition_authenticated": false,
      "human_blind_predictive_validation_count": 0,
      "runtime_astrological_rule_promoted": false
    },
    {
      "id": "ZWD-R0778",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-18SRC-Spouses",
      "source_original_online_revision": 1963110,
      "full_source_wikitext_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "source_kind": "SOURCE_HISTORICAL_TEXT_LINE",
      "original_source_Chinese_exact_line": "天府相生宠爱夫主贵，见羊陀火铃空劫迟娶免刑，晚娶得谐老。",
      "quote_sha256": "67443600abc6d7f767ccef203b85aa69fb82d316defb64f49a1739a68d4bf596",
      "quote_UTF8_bytes": 84,
      "absolute_codepoint_offset": 38573,
      "absolute_UTF8_byte_offset": 77823,
      "relative_section_codepoint_offset": 335,
      "source_historic_gender_and_marriage_claims_not_advice": true,
      "original_printed_early_edition_authenticated": false,
      "human_blind_predictive_validation_count": 0,
      "runtime_astrological_rule_promoted": false
    },
    {
      "id": "ZWD-R0779",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-18SRC-Spouses",
      "source_original_online_revision": 1963110,
      "full_source_wikitext_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "source_kind": "SOURCE_HISTORICAL_TEXT_LINE",
      "original_source_Chinese_exact_line": "太阴入庙男女皆贵美夫妇，加昌曲极美，加羊陀火铃空劫耗忌，不克主生离，太阳同谐老，夫同同内助，天机同美好宜少年。",
      "quote_sha256": "6e85f0a9b72000ec1c02f10c8b49946b1b0bbe488bfc95ac03927a5005f2cbb9",
      "quote_UTF8_bytes": 165,
      "absolute_codepoint_offset": 38604,
      "absolute_UTF8_byte_offset": 77910,
      "relative_section_codepoint_offset": 366,
      "source_historic_gender_and_marriage_claims_not_advice": true,
      "original_printed_early_edition_authenticated": false,
      "human_blind_predictive_validation_count": 0,
      "runtime_astrological_rule_promoted": false
    },
    {
      "id": "ZWD-R0780",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-18SRC-Spouses",
      "source_original_online_revision": 1963110,
      "full_source_wikitext_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "source_kind": "SOURCE_HISTORICAL_TEXT_LINE",
      "original_source_Chinese_exact_line": "贪狼男女不得美，三次作新郎，入庙宜迟娶，廉贞同主克，加羊陀火铃主生离，紫微同年长方可对。",
      "quote_sha256": "6a846c6d270832a5769676750bff7a5fa86f30d5b0f8d210a1bfc41a5223eaa4",
      "quote_UTF8_bytes": 132,
      "absolute_codepoint_offset": 38662,
      "absolute_UTF8_byte_offset": 78078,
      "relative_section_codepoint_offset": 424,
      "source_historic_gender_and_marriage_claims_not_advice": true,
      "original_printed_early_edition_authenticated": false,
      "human_blind_predictive_validation_count": 0,
      "runtime_astrological_rule_promoted": false
    },
    {
      "id": "ZWD-R0781",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-18SRC-Spouses",
      "source_original_online_revision": 1963110,
      "full_source_wikitext_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "source_kind": "SOURCE_HISTORICAL_TEXT_LINE",
      "original_source_Chinese_exact_line": "巨门宜年长定克欠和，太阳同无四杀加谐老，天机同内助美貌，天同同性聪之妻并头，加羊陀火铃空劫定克二妻或主生离。",
      "quote_sha256": "53d07acd475d5fcc53f080ad25c213f284c55de25b0c36d7e0c56679ab1eb625",
      "quote_UTF8_bytes": 162,
      "absolute_codepoint_offset": 38709,
      "absolute_UTF8_byte_offset": 78213,
      "relative_section_codepoint_offset": 471,
      "source_historic_gender_and_marriage_claims_not_advice": true,
      "original_printed_early_edition_authenticated": false,
      "human_blind_predictive_validation_count": 0,
      "runtime_astrological_rule_promoted": false
    },
    {
      "id": "ZWD-R0782",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-18SRC-Spouses",
      "source_original_online_revision": 1963110,
      "full_source_wikitext_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "source_kind": "SOURCE_HISTORICAL_TEXT_LINE",
      "original_source_Chinese_exact_line": "天相貌美贤淑夫宜年长，亲上成亲，紫微同谐老，武曲少和，廉贞同入庙免刑，加羊陀火铃空劫刑克。",
      "quote_sha256": "d2051134f0920b4eabb40ccc2fc62261da5218d61ae9e14aacd24a61f0532f80",
      "quote_UTF8_bytes": 135,
      "absolute_codepoint_offset": 38766,
      "absolute_UTF8_byte_offset": 78378,
      "relative_section_codepoint_offset": 528,
      "source_historic_gender_and_marriage_claims_not_advice": true,
      "original_printed_early_edition_authenticated": false,
      "human_blind_predictive_validation_count": 0,
      "runtime_astrological_rule_promoted": false
    },
    {
      "id": "ZWD-R0783",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-18SRC-Spouses",
      "source_original_online_revision": 1963110,
      "full_source_wikitext_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "source_kind": "SOURCE_HISTORICAL_TEXT_LINE",
      "original_source_Chinese_exact_line": "天梁妻宜大美容，天同同和气，天机招美淑，加羊陀火铃空劫朵不和顺。",
      "quote_sha256": "c14feec4bea60dbdebec56cc97488ef266405defd6772d6c91de5879adc8a086",
      "quote_UTF8_bytes": 96,
      "absolute_codepoint_offset": 38814,
      "absolute_UTF8_byte_offset": 78516,
      "relative_section_codepoint_offset": 576,
      "source_historic_gender_and_marriage_claims_not_advice": true,
      "original_printed_early_edition_authenticated": false,
      "human_blind_predictive_validation_count": 0,
      "runtime_astrological_rule_promoted": false
    },
    {
      "id": "ZWD-R0784",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-18SRC-Spouses",
      "source_original_online_revision": 1963110,
      "full_source_wikitext_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "source_kind": "SOURCE_HISTORICAL_TEXT_LINE",
      "original_source_Chinese_exact_line": "七杀早克，武曲同亦克，或迟娶免刑，廉贞主生离，加羊陀火铃空劫克三妻。",
      "quote_sha256": "65c1934421eb92818abdff9c4c7b512aa75919d11b90965e9e10e9b00070719f",
      "quote_UTF8_bytes": 102,
      "absolute_codepoint_offset": 38849,
      "absolute_UTF8_byte_offset": 78615,
      "relative_section_codepoint_offset": 611,
      "source_historic_gender_and_marriage_claims_not_advice": true,
      "original_printed_early_edition_authenticated": false,
      "human_blind_predictive_validation_count": 0,
      "runtime_astrological_rule_promoted": false
    },
    {
      "id": "ZWD-R0785",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-18SRC-Spouses",
      "source_original_online_revision": 1963110,
      "full_source_wikitext_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "source_kind": "SOURCE_HISTORICAL_TEXT_LINE",
      "original_source_Chinese_exact_line": "破军男女俱克别聚主生离，武曲同克三，廉贞亦克且欠和，紫微同宜年长之妻。",
      "quote_sha256": "cb82e4e99ec9b5c94636789ad6409cbee821058ca98baa5b07c0dd0650e02c0c",
      "quote_UTF8_bytes": 105,
      "absolute_codepoint_offset": 38886,
      "absolute_UTF8_byte_offset": 78720,
      "relative_section_codepoint_offset": 648,
      "source_historic_gender_and_marriage_claims_not_advice": true,
      "original_printed_early_edition_authenticated": false,
      "human_blind_predictive_validation_count": 0,
      "runtime_astrological_rule_promoted": false
    },
    {
      "id": "ZWD-R0786",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-18SRC-Spouses",
      "source_original_online_revision": 1963110,
      "full_source_wikitext_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "source_kind": "SOURCE_HISTORICAL_TEXT_LINE",
      "original_source_Chinese_exact_line": "文昌妻少内助聪明，天机太阴同主美容，不宜陷地，加羊陀火铃空劫深忌。",
      "quote_sha256": "6684a9b0354a82055cddc5ba05dfac4d536d8ecf152754b021dc96eaedd2ca51",
      "quote_UTF8_bytes": 99,
      "absolute_codepoint_offset": 38924,
      "absolute_UTF8_byte_offset": 78828,
      "relative_section_codepoint_offset": 686,
      "source_historic_gender_and_marriage_claims_not_advice": true,
      "original_printed_early_edition_authenticated": false,
      "human_blind_predictive_validation_count": 0,
      "runtime_astrological_rule_promoted": false
    },
    {
      "id": "ZWD-R0787",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-18SRC-Spouses",
      "source_original_online_revision": 1963110,
      "full_source_wikitext_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "source_kind": "SOURCE_HISTORICAL_TEXT_LINE",
      "original_source_Chinese_exact_line": "文曲相生会太阴诸吉星谐老，同昌曲妻妾多，加羊陀火铃空劫忌星有克。",
      "quote_sha256": "95af68dabe653ef0e990619f73d5dc48a3afca49443825e97bd16e3416e477ea",
      "quote_UTF8_bytes": 96,
      "absolute_codepoint_offset": 38960,
      "absolute_UTF8_byte_offset": 78930,
      "relative_section_codepoint_offset": 722,
      "source_historic_gender_and_marriage_claims_not_advice": true,
      "original_printed_early_edition_authenticated": false,
      "human_blind_predictive_validation_count": 0,
      "runtime_astrological_rule_promoted": false
    },
    {
      "id": "ZWD-R0788",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-18SRC-Spouses",
      "source_original_online_revision": 1963110,
      "full_source_wikitext_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "source_kind": "SOURCE_HISTORICAL_TEXT_LINE",
      "original_source_Chinese_exact_line": "禄存相生无克，妻宜年少并头迟娶者，加羊陀火铃空劫见截路空亡孤单。",
