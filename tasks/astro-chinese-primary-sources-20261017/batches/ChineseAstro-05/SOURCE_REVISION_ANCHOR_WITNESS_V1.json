      "raw_byte_count": 3775,
      "exact_chinese_quote": "天全一氣，不可使地道莫之載。",
      "raw_char_offset": 782,
      "raw_utf8_byte_offset": 1886,
      "exact_quote_sha256": "406de4b307d98e76bf64b8d593c850aed61c1564fc3be7e31350a3b201c6f6f1",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
