    {
      "record_id": "BZI-R0047",
      "chapter_code": "01",
      "oldid": 844395,
      "full_raw_page_sha256": "714bb5290a81d50d603aaf9098204102b72d625acd49c037305107bf2110c6a5",
      "raw_byte_count": 2016,
      "exact_chinese_quote": "欲識三元萬物宗，先觀帝載與神功。",
      "raw_char_offset": 60,
      "raw_utf8_byte_offset": 74,
      "exact_quote_sha256": "c8cfc82e53d9b0e894aca1e0f6e570400bacbe00bee0a1705912eaab8dc8f0ea",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0048",
      "chapter_code": "01",
      "oldid": 844395,
      "full_raw_page_sha256": "714bb5290a81d50d603aaf9098204102b72d625acd49c037305107bf2110c6a5",
      "raw_byte_count": 2016,
      "exact_chinese_quote": "坤元合德機緘通，五氣偏全定吉凶。",
      "raw_char_offset": 164,
      "raw_utf8_byte_offset": 336,
      "exact_quote_sha256": "af6331e1c6e744560d176247bc4a6c77b8a79e05110538768e29a30ee638db3c",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0049",
      "chapter_code": "01",
      "oldid": 844395,
      "full_raw_page_sha256": "714bb5290a81d50d603aaf9098204102b72d625acd49c037305107bf2110c6a5",
      "raw_byte_count": 2016,
      "exact_chinese_quote": "戴天履地人為貴，順則吉兮悖則凶。",
      "raw_char_offset": 251,
      "raw_utf8_byte_offset": 547,
      "exact_quote_sha256": "77cf9909732b0b53ffec68d013c86b35fa1326382c393b03935565f56d8cd19c",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0050",
      "chapter_code": "01",
      "oldid": 844395,
      "full_raw_page_sha256": "714bb5290a81d50d603aaf9098204102b72d625acd49c037305107bf2110c6a5",
      "raw_byte_count": 2016,
      "exact_chinese_quote": "欲與人間開聾瞶，順悖之機須理會。",
      "raw_char_offset": 341,
      "raw_utf8_byte_offset": 767,
      "exact_quote_sha256": "c6ee4335d66aeca65dc2f3c9049d42a7d790a57e8470a98c2428a3272a0d81ea",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0051",
      "chapter_code": "01",
      "oldid": 844395,
      "full_raw_page_sha256": "714bb5290a81d50d603aaf9098204102b72d625acd49c037305107bf2110c6a5",
      "raw_byte_count": 2016,
      "exact_chinese_quote": "理承氣行荳有常，進兮退兮宜抑揚。",
      "raw_char_offset": 413,
      "raw_utf8_byte_offset": 933,
      "exact_quote_sha256": "6b21aad446f7db97d9fcb503a96ff38c9c6764e9882399ee3670a9869a2cb827",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0052",
      "chapter_code": "01",
      "oldid": 844395,
      "full_raw_page_sha256": "714bb5290a81d50d603aaf9098204102b72d625acd49c037305107bf2110c6a5",
      "raw_byte_count": 2016,
      "exact_chinese_quote": "配合干支仔細詳，斷人禍福與災祥。",
      "raw_char_offset": 533,
      "raw_utf8_byte_offset": 1243,
      "exact_quote_sha256": "fb8df4c4c61b30b18d476b7f713d73bf55f9ec62a219d4f5a680baa006f94dfe",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0053",
      "chapter_code": "01",
      "oldid": 844395,
      "full_raw_page_sha256": "714bb5290a81d50d603aaf9098204102b72d625acd49c037305107bf2110c6a5",
      "raw_byte_count": 2016,
      "exact_chinese_quote": "五陽皆陽丙為最，五陰皆陰癸為至。",
      "raw_char_offset": 589,
      "raw_utf8_byte_offset": 1361,
      "exact_quote_sha256": "dc563941d49e2cebf11e290588cfc877a36f80e7f32d6e94b1a67821c23e1114",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0054",
      "chapter_code": "01",
      "oldid": 844395,
      "full_raw_page_sha256": "714bb5290a81d50d603aaf9098204102b72d625acd49c037305107bf2110c6a5",
      "raw_byte_count": 2016,
      "exact_chinese_quote": "五陽從氣不從勢，五陰從勢無情義。",
      "raw_char_offset": 692,
      "raw_utf8_byte_offset": 1616,
      "exact_quote_sha256": "a9d8ef4daf6ad58f78b43a6653669f68df535ea0f9dc40d634a644085707644e",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0055",
      "chapter_code": "02",
      "oldid": 11117658,
      "full_raw_page_sha256": "31d66e10a07c77ec23a75acadfa7e6a85f81fcb783e5322e6e52aec11a02deca",
      "raw_byte_count": 5645,
      "exact_chinese_quote": "甲木參天，脱胎要火，春不容金，秋不容土，火熾乘龍，水蕩騎虎，地潤天和，植立千古。",
      "raw_char_offset": 72,
      "raw_utf8_byte_offset": 90,
      "exact_quote_sha256": "a60e32ed96a4188d4d551e3eee6b9a2c292d793a265d20d7fdc9da384c9521c3",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0056",
      "chapter_code": "02",
      "oldid": 11117658,
      "full_raw_page_sha256": "31d66e10a07c77ec23a75acadfa7e6a85f81fcb783e5322e6e52aec11a02deca",
      "raw_byte_count": 5645,
      "exact_chinese_quote": "乙木雖柔，刲羊解牛，懷丁抱丙，跨雞乘猴，虛濕之地，騎馬亦憂，籐蘿繫甲，可春可秋。",
      "raw_char_offset": 306,
      "raw_utf8_byte_offset": 722,
      "exact_quote_sha256": "ef3da6d964e0fc0450a38035f9027ba506176e2e5506f35182f79d2420702067",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0057",
      "chapter_code": "02",
      "oldid": 11117658,
      "full_raw_page_sha256": "31d66e10a07c77ec23a75acadfa7e6a85f81fcb783e5322e6e52aec11a02deca",
      "raw_byte_count": 5645,
      "exact_chinese_quote": "丙火猛烈，欺霜侮雪，能煆庚金，逄辛反怯，土眾成慈，水猖顯節，虎馬犬鄉，甲來焚滅。",
      "raw_char_offset": 523,
      "raw_utf8_byte_offset": 1307,
      "exact_quote_sha256": "1a65e4d0256a3a6ca5c47d7c9c65d734b8f932b967b550c29205ac6b396378c6",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0058",
      "chapter_code": "02",
      "oldid": 11117658,
      "full_raw_page_sha256": "31d66e10a07c77ec23a75acadfa7e6a85f81fcb783e5322e6e52aec11a02deca",
      "raw_byte_count": 5645,
      "exact_chinese_quote": "丁火柔中，內性昭融，抱乙而考，合壬而忠，旺而不烈，衰而不窮，如有嫡母，可秋可冬。",
      "raw_char_offset": 708,
      "raw_utf8_byte_offset": 1796,
      "exact_quote_sha256": "b17dd0737d5c4cdc0b114da4a5c422ca47d46664aab8f7d51f17e8b3b5e82ea8",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0059",
      "chapter_code": "02",
      "oldid": 11117658,
      "full_raw_page_sha256": "31d66e10a07c77ec23a75acadfa7e6a85f81fcb783e5322e6e52aec11a02deca",
      "raw_byte_count": 5645,
      "exact_chinese_quote": "戊土固重，既中且正，靜翕動闢，萬物司命，水旺物生，火燥囍潤，若在坤艮，怕沖宜靜。",
      "raw_char_offset": 956,
      "raw_utf8_byte_offset": 2474,
      "exact_quote_sha256": "1b32c3283a46a418a61297135164e09ea5b8a0cedab526d51a7c2aeb84697748",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0060",
      "chapter_code": "02",
      "oldid": 11117658,
      "full_raw_page_sha256": "31d66e10a07c77ec23a75acadfa7e6a85f81fcb783e5322e6e52aec11a02deca",
      "raw_byte_count": 5645,
      "exact_chinese_quote": "己土卑濕，中正蓄藏，不愁木盛，不畏水旺，火少火晦，金多金明，若要物昌，宜助宜幫。",
      "raw_char_offset": 1137,
      "raw_utf8_byte_offset": 2951,
      "exact_quote_sha256": "d9511856fac4d37578f0a5e0535973cf345fe227d23fd12c23b0c06eaeb27ea7",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0061",
      "chapter_code": "02",
      "oldid": 11117658,
      "full_raw_page_sha256": "31d66e10a07c77ec23a75acadfa7e6a85f81fcb783e5322e6e52aec11a02deca",
      "raw_byte_count": 5645,
      "exact_chinese_quote": "庚金帶煞，剛強為最，得水而清，得火而銳，土潤則生，土乾則脆，能勝甲兄，輸於乙妹。",
      "raw_char_offset": 1347,
      "raw_utf8_byte_offset": 3515,
      "exact_quote_sha256": "13a1ae7fb515e44ff8e7d3abcaf20e8f3547f57941237150fe7144e360f9e04d",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0062",
      "chapter_code": "02",
      "oldid": 11117658,
      "full_raw_page_sha256": "31d66e10a07c77ec23a75acadfa7e6a85f81fcb783e5322e6e52aec11a02deca",
      "raw_byte_count": 5645,
      "exact_chinese_quote": "辛金軟弱，溫潤而清，畏土之疊，樂水之盈，能扶社稷，能救生靈，熱則喜母，寒則喜丁。",
      "raw_char_offset": 1503,
      "raw_utf8_byte_offset": 3917,
      "exact_quote_sha256": "443439429c7be04919e9469d8ffb34e881127e91132e81e2bb57d67d039999de",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0063",
      "chapter_code": "02",
      "oldid": 11117658,
      "full_raw_page_sha256": "31d66e10a07c77ec23a75acadfa7e6a85f81fcb783e5322e6e52aec11a02deca",
      "raw_byte_count": 5645,
      "exact_chinese_quote": "壬水汪洋，能洩金氣，剛中之德，周流不滯，通根透癸，沖天奔地，化則有情，從則相濟。",
      "raw_char_offset": 1754,
      "raw_utf8_byte_offset": 4604,
      "exact_quote_sha256": "9da8496fd876bb6b12e1ca02a53adcb911e43eeffecb90830dcab138e48c3dc5",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0064",
      "chapter_code": "02",
      "oldid": 11117658,
      "full_raw_page_sha256": "31d66e10a07c77ec23a75acadfa7e6a85f81fcb783e5322e6e52aec11a02deca",
      "raw_byte_count": 5645,
      "exact_chinese_quote": "癸水至弱，達於天津，龍德而運，功化斯神，不畏火土，不論庚辛，合戊見火，火根乃真。",
      "raw_char_offset": 1975,
      "raw_utf8_byte_offset": 5201,
      "exact_quote_sha256": "0470b207ce89d9becaa66f3c49d43cf5b1a00ebc31fc2e0825c966a07745df0e",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0065",
      "chapter_code": "03",
      "oldid": 844351,
      "full_raw_page_sha256": "0b1f7d4b68d49cb9dbbf97f77d07cee8c8e2fb638984357c93648d59cf99f334",
      "raw_byte_count": 3775,
      "exact_chinese_quote": "陽支動且強，速達顯災祥。",
      "raw_char_offset": 62,
      "raw_utf8_byte_offset": 76,
      "exact_quote_sha256": "7d75c5135eea45b27eb942b41abf6a4521fedaa4d7205895b3a4060958792bcf",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0066",
      "chapter_code": "03",
      "oldid": 844351,
      "full_raw_page_sha256": "0b1f7d4b68d49cb9dbbf97f77d07cee8c8e2fb638984357c93648d59cf99f334",
      "raw_byte_count": 3775,
      "exact_chinese_quote": "陰支靜且專，否泰每經年。",
      "raw_char_offset": 135,
      "raw_utf8_byte_offset": 245,
      "exact_quote_sha256": "6059fc3bdcf7d6d33dd8a8d870e314037cfce227a512be720a4255f1317b6aa0",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0067",
      "chapter_code": "03",
      "oldid": 844351,
      "full_raw_page_sha256": "0b1f7d4b68d49cb9dbbf97f77d07cee8c8e2fb638984357c93648d59cf99f334",
      "raw_byte_count": 3775,
      "exact_chinese_quote": "生方怕動庫宜開，敗地逄沖子細裁。",
      "raw_char_offset": 210,
      "raw_utf8_byte_offset": 420,
      "exact_quote_sha256": "243596d1275b2c2f5d8288143ffbe3f81a1cc9818faab8b47ecd77ebf1998a36",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0068",
      "chapter_code": "03",
      "oldid": 844351,
      "full_raw_page_sha256": "0b1f7d4b68d49cb9dbbf97f77d07cee8c8e2fb638984357c93648d59cf99f334",
      "raw_byte_count": 3775,
      "exact_chinese_quote": "支神祇以沖為重，刑與害兮動不動。",
      "raw_char_offset": 332,
      "raw_utf8_byte_offset": 736,
      "exact_quote_sha256": "a1e24ab4fcea97b5cb0977eee85e14526892b1a0e2a3761cb3a599037e511df4",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0069",
      "chapter_code": "03",
      "oldid": 844351,
      "full_raw_page_sha256": "0b1f7d4b68d49cb9dbbf97f77d07cee8c8e2fb638984357c93648d59cf99f334",
      "raw_byte_count": 3775,
      "exact_chinese_quote": "暗沖暗會尤為喜，彼衝我兮皆衝起。",
      "raw_char_offset": 412,
      "raw_utf8_byte_offset": 926,
      "exact_quote_sha256": "fbeb4955ae8fd362ca0b9e16dc3928218f8b68f4e50ec6c39e8d472e24a6c287",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0070",
      "chapter_code": "03",
      "oldid": 844351,
      "full_raw_page_sha256": "0b1f7d4b68d49cb9dbbf97f77d07cee8c8e2fb638984357c93648d59cf99f334",
      "raw_byte_count": 3775,
      "exact_chinese_quote": "旺者沖衰衰者拔，衰者沖旺旺神發。",
      "raw_char_offset": 551,
      "raw_utf8_byte_offset": 1293,
      "exact_quote_sha256": "0fc936677b82f4a493066c981894a2f4e88a7f0532ecb6cb7cf59b36c6b527fe",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
      "record_id": "BZI-R0071",
      "chapter_code": "03",
      "oldid": 844351,
      "full_raw_page_sha256": "0b1f7d4b68d49cb9dbbf97f77d07cee8c8e2fb638984357c93648d59cf99f334",
      "raw_byte_count": 3775,
      "exact_chinese_quote": "陽順陰逆，其理固殊，陽生陰死，其論勿執。",
      "raw_char_offset": 624,
      "raw_utf8_byte_offset": 1462,
      "exact_quote_sha256": "59067bbb1521c7a5ff33ac716c5d4f1b20eab0cd25d536e5ce03ee1d7cdc9aa1",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
