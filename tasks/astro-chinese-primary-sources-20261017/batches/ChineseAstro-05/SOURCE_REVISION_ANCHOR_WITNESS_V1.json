      "raw_byte_count": 2631,
      "exact_chinese_quote": "影響遙繫既為虛，雜氣財官不可拘。",
      "raw_char_offset": 202,
      "raw_utf8_byte_offset": 442,
      "exact_quote_sha256": "550741c1a39d8fa1b49b78afe181365072ed4919c26a153211f158243b8421b3",
