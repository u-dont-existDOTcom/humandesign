      "raw_byte_count": 2631,
      "exact_chinese_quote": "財官印綬分偏正，兼論食傷格局定。",
      "raw_char_offset": 62,
      "raw_utf8_byte_offset": 76,
      "exact_quote_sha256": "10b1d961baafd8fdbbfeaaca3015d1adf0ec65a27c150992f1f11c69c96fef8b",
