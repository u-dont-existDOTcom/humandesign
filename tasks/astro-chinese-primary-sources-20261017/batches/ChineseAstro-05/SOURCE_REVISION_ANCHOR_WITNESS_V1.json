      "oldid": 844351,
      "full_raw_page_sha256": "0b1f7d4b68d49cb9dbbf97f77d07cee8c8e2fb638984357c93648d59cf99f334",
      "raw_byte_count": 3775,
      "exact_chinese_quote": "地全三物，不可使天道莫之覆。",
      "raw_char_offset": 843,
      "raw_utf8_byte_offset": 2019,
      "exact_quote_sha256": "103e59b8fbce5727dcbf4b2dd39044b4bec64e81e48f557c9f6d5791ae3700e1",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
