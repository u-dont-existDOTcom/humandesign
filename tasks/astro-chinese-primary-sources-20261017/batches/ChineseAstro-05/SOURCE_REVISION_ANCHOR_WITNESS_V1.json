      "full_raw_page_sha256": "0b1f7d4b68d49cb9dbbf97f77d07cee8c8e2fb638984357c93648d59cf99f334",
      "raw_byte_count": 3775,
      "exact_chinese_quote": "陽乘陽位陽氣昌，最要行程安頓。",
      "raw_char_offset": 902,
      "raw_utf8_byte_offset": 2146,
      "exact_quote_sha256": "f0c7c17b9ea89ea80c71e84e865692ec54b1fe9f746db54d04da74c5784f6c05",
      "source_layer": "TRANSMITTED_VERSE"
    },
    {
