{
  "schema": "BAZI_DITIAN_SUI_SIX_PAGES_53_SHA_OFFSET_WITNESSES_V1",
  "batch": "ChineseAstro-06",
  "original_source_manifest_SHA256": "c3b9362e51201c350af3041291b497dce313ea986f1c35fc2a5269d57d59ab7a",
  "matched_independently_pinned_source_quotes": 53,
  "verse_quotes": 15,
  "commentary_quotes": 38,
  "source_is_original_diplomatic_early_witness": false,
  "independent_expert_Chinese_glosses_validated": false,
  "birthdate_true_solar_time_calculations_validated": false,
  "actual_real_person_outcome_validation_count": 0,
  "runtime_promotions": 0,
  "quote_receipts": [
    {
      "id": "BZI-R0102",
      "section": "04",
      "oldid": 844352,
      "whole_raw_source_SHA256": "5455b60b30f0770ebf8e78e6be715b72c1de2607947bc976476b16e0c49e9bef",
      "whole_raw_source_bytes": 979,
      "anchor_literal": "兩氣合而成象，像不可破也。",
      "anchor_character_offset": 62,
      "anchor_UTF8_byte_offset": 76,
      "anchor_UTF8_SHA256": "f16d7ae3b10df836dfb5543ed9f73aacde5b1c4742d853f04bc244b34b95cdc5",
      "source_verse_or_commentary": "TRANSMITTED_VERSE"
    },
    {
      "id": "BZI-R0103",
      "section": "04",
      "oldid": 844352,
      "whole_raw_source_SHA256": "5455b60b30f0770ebf8e78e6be715b72c1de2607947bc976476b16e0c49e9bef",
      "whole_raw_source_bytes": 979,
      "anchor_literal": "五氣聚而成形，形不可害也。",
      "anchor_character_offset": 132,
      "anchor_UTF8_byte_offset": 236,
      "anchor_UTF8_SHA256": "67a4c904580212bf48c351b706a9eb04c60c419af3abc66b1dd096b37e24fe13",
      "source_verse_or_commentary": "TRANSMITTED_VERSE"
    },
    {
      "id": "BZI-R0104",
      "section": "04",
      "oldid": 844352,
      "whole_raw_source_SHA256": "5455b60b30f0770ebf8e78e6be715b72c1de2607947bc976476b16e0c49e9bef",
      "whole_raw_source_bytes": 979,
      "anchor_literal": "獨象喜行化地，而化神要昌。",
      "anchor_character_offset": 213,
      "anchor_UTF8_byte_offset": 429,
      "anchor_UTF8_SHA256": "b8e67496a10ed464e7582fc93dd852df96a2727b856086319dcf851fc9172731",
      "source_verse_or_commentary": "TRANSMITTED_VERSE"
    },
    {
      "id": "BZI-R0105",
      "section": "04",
      "oldid": 844352,
      "whole_raw_source_SHA256": "5455b60b30f0770ebf8e78e6be715b72c1de2607947bc976476b16e0c49e9bef",
      "whole_raw_source_bytes": 979,
      "anchor_literal": "全像喜行財地，而財神要旺。",
      "anchor_character_offset": 286,
      "anchor_UTF8_byte_offset": 598,
      "anchor_UTF8_SHA256": "a419958d3b1eb091c371673f4eb534d6551d85c92ef276ecb7b18c81358a2c89",
      "source_verse_or_commentary": "TRANSMITTED_VERSE"
    },
    {
      "id": "BZI-R0106",
      "section": "05",
      "oldid": 844353,
      "whole_raw_source_SHA256": "df699134405a00601b1d580610413553b8133af312bc8572914960570f51e48a",
      "whole_raw_source_bytes": 1019,
      "anchor_literal": "方是方兮局是局，方要得方莫混局。",
      "anchor_character_offset": 62,
      "anchor_UTF8_byte_offset": 76,
      "anchor_UTF8_SHA256": "b3d72ff3f4b8e357cecfaa3cb7cb1c52547e810fb554c55f07bb11df9b07e37c",
      "source_verse_or_commentary": "TRANSMITTED_VERSE"
    },
    {
      "id": "BZI-R0107",
      "section": "05",
      "oldid": 844353,
      "whole_raw_source_SHA256": "df699134405a00601b1d580610413553b8133af312bc8572914960570f51e48a",
      "whole_raw_source_bytes": 1019,
      "anchor_literal": "局混方兮有純庛，行運喜南或喜北。",
      "anchor_character_offset": 130,
      "anchor_UTF8_byte_offset": 230,
      "anchor_UTF8_SHA256": "ff3539a3c00d408dbe6224cf5b181ec35db208ccd4c3669585b308541a351f10",
      "source_verse_or_commentary": "TRANSMITTED_VERSE"
    },
    {
      "id": "BZI-R0108",
      "section": "05",
      "oldid": 844353,
      "whole_raw_source_SHA256": "df699134405a00601b1d580610413553b8133af312bc8572914960570f51e48a",
      "whole_raw_source_bytes": 1019,
      "anchor_literal": "若然方局一齊來，須是干頭無反覆。",
      "anchor_character_offset": 204,
      "anchor_UTF8_byte_offset": 402,
      "anchor_UTF8_SHA256": "26f4e78822038d17ead0bf3f111c4a9a13c6dea48082525dfd076f3f026a26d7",
      "source_verse_or_commentary": "TRANSMITTED_VERSE"
    },
    {
      "id": "BZI-R0109",
      "section": "05",
      "oldid": 844353,
      "whole_raw_source_SHA256": "df699134405a00601b1d580610413553b8133af312bc8572914960570f51e48a",
      "whole_raw_source_bytes": 1019,
      "anchor_literal": "成方乾透一元神，生地庫地皆非福。",
      "anchor_character_offset": 267,
      "anchor_UTF8_byte_offset": 541,
      "anchor_UTF8_SHA256": "f79fe2867eb763cffa8dc087b7f8c1a3ff53e5be1ae879b4eb4f085c231cf354",
      "source_verse_or_commentary": "TRANSMITTED_VERSE"
    },
    {
      "id": "BZI-R0110",
      "section": "05",
      "oldid": 844353,
      "whole_raw_source_SHA256": "df699134405a00601b1d580610413553b8133af312bc8572914960570f51e48a",
      "whole_raw_source_bytes": 1019,
      "anchor_literal": "成局乾透一官星，左邊右邊空碌碌。",
      "anchor_character_offset": 350,
      "anchor_UTF8_byte_offset": 740,
      "anchor_UTF8_SHA256": "2a8fa3773709909ccc25cadbb5e70f9f14cf51d8bc52b8bc37a85975685216cf",
      "source_verse_or_commentary": "TRANSMITTED_VERSE"
    },
    {
      "id": "BZI-R0111",
      "section": "07",
      "oldid": 844355,
      "whole_raw_source_SHA256": "f4b092b4fc39897ca4ff1a356861d8e787cb87360bccf80bbcd851acc496fe55",
      "whole_raw_source_bytes": 1142,
      "anchor_literal": "從得真者只論從，從神又有吉和凶。",
      "anchor_character_offset": 64,
      "anchor_UTF8_byte_offset": 82,
      "anchor_UTF8_SHA256": "e23b71a2b155b21e54332785821c5c6277eb58a447e1ee63f0e125fc6c403bdd",
      "source_verse_or_commentary": "TRANSMITTED_VERSE"
    },
    {
      "id": "BZI-R0112",
      "section": "07",
      "oldid": 844355,
      "whole_raw_source_SHA256": "f4b092b4fc39897ca4ff1a356861d8e787cb87360bccf80bbcd851acc496fe55",
      "whole_raw_source_bytes": 1142,
      "anchor_literal": "化得真者只論化，化神還有幾般話。",
      "anchor_character_offset": 198,
      "anchor_UTF8_byte_offset": 434,
      "anchor_UTF8_SHA256": "8a0e8434e3c5a2f2c680df26a0b2ef3af3c57cdfa1a06f2bda802d6fea22b472",
      "source_verse_or_commentary": "TRANSMITTED_VERSE"
    },
    {
      "id": "BZI-R0113",
      "section": "08",
      "oldid": 844356,
      "whole_raw_source_SHA256": "7264788dac3dc81bd84396b848adcde978407146d44e642025bcded785aa1d7b",
      "whole_raw_source_bytes": 710,
      "anchor_literal": "真從之像有幾人，假從亦可發其身。",
      "anchor_character_offset": 64,
      "anchor_UTF8_byte_offset": 82,
      "anchor_UTF8_SHA256": "eb287558a87b9324912123be378b27b3be4503e2d13a7842fa3de78251a920f5",
      "source_verse_or_commentary": "TRANSMITTED_VERSE"
    },
    {
      "id": "BZI-R0114",
      "section": "08",
      "oldid": 844356,
      "whole_raw_source_SHA256": "7264788dac3dc81bd84396b848adcde978407146d44e642025bcded785aa1d7b",
      "whole_raw_source_bytes": 710,
      "anchor_literal": "假化之人亦可貴，孤兒異姓能出類。",
      "anchor_character_offset": 166,
      "anchor_UTF8_byte_offset": 338,
      "anchor_UTF8_SHA256": "9e3ec4ceaf711d54ca844f526c529f5e847bd9747928ae7f3d27e5bcb943d203",
      "source_verse_or_commentary": "TRANSMITTED_VERSE"
    },
    {
      "id": "BZI-R0115",
      "section": "11",
      "oldid": 844359,
      "whole_raw_source_SHA256": "25de00a87d15b15339eff5d4c70e2c44c4aaaf05f78df50c0b763f1e96a18b51",
      "whole_raw_source_bytes": 727,
      "anchor_literal": "人有精神，不可以一偏求也，要在損之益之得其中。",
      "anchor_character_offset": 62,
      "anchor_UTF8_byte_offset": 76,
      "anchor_UTF8_SHA256": "182ec8ddc70b0c5c1c031f2ad2a3f3c223b51a532a48941e2bee1c1c8c4e5ec7",
      "source_verse_or_commentary": "TRANSMITTED_VERSE"
    },
    {
      "id": "BZI-R0116",
      "section": "12",
      "oldid": 844360,
      "whole_raw_source_SHA256": "c17a857454f0e545b63c90dac9ddac0361d61cfe07718f7a5a793b4a2ff2ec80",
      "whole_raw_source_bytes": 547,
      "anchor_literal": "能知衰旺之真機，其於立命之奧，思過半矣。",
      "anchor_character_offset": 62,
      "anchor_UTF8_byte_offset": 76,
      "anchor_UTF8_SHA256": "0898181f6653c67ae7175e7070e44701ae7a5ff88206b6d21d27d4830ba40772",
      "source_verse_or_commentary": "TRANSMITTED_VERSE"
    },
    {
      "id": "BZI-R0117",
      "section": "04",
      "oldid": 844352,
      "whole_raw_source_SHA256": "5455b60b30f0770ebf8e78e6be715b72c1de2607947bc976476b16e0c49e9bef",
      "whole_raw_source_bytes": 979,
      "anchor_literal": "天干屬木，地支屬火，天干屬火，地支屬木，若見金即破",
      "anchor_character_offset": 84,
      "anchor_UTF8_byte_offset": 128,
      "anchor_UTF8_SHA256": "eb4a967b8578f2b9b3f713ed694fb5201dd31bf111f52c437bc84ba1123dd30f",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0118",
      "section": "04",
      "oldid": 844352,
      "whole_raw_source_SHA256": "5455b60b30f0770ebf8e78e6be715b72c1de2607947bc976476b16e0c49e9bef",
      "whole_raw_source_bytes": 979,
      "anchor_literal": "如木必得水以生之，火以行之，土以培之，金以成之",
      "anchor_character_offset": 154,
      "anchor_UTF8_byte_offset": 288,
      "anchor_UTF8_SHA256": "f0bf8837440052297446dfb766d623e444de57bc03fbe6d351b1139fff5aeef9",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0119",
      "section": "04",
      "oldid": 844352,
      "whole_raw_source_SHA256": "5455b60b30f0770ebf8e78e6be715b72c1de2607947bc976476b16e0c49e9bef",
      "whole_raw_source_bytes": 979,
      "anchor_literal": "五者聚而成形或過或缺則害",
      "anchor_character_offset": 178,
      "anchor_UTF8_byte_offset": 360,
      "anchor_UTF8_SHA256": "08db164b3c4988715d5700815c84ed24d10b4f5d3116f3f9689c461cffd4f15f",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0120",
      "section": "04",
      "oldid": 844352,
      "whole_raw_source_SHA256": "5455b60b30f0770ebf8e78e6be715b72c1de2607947bc976476b16e0c49e9bef",
      "whole_raw_source_bytes": 979,
      "anchor_literal": "一氣者為獨，曲直炎上之類是也",
      "anchor_character_offset": 235,
      "anchor_UTF8_byte_offset": 481,
      "anchor_UTF8_SHA256": "bca3920fa4945563299265d195e6c0c4b9a89e440145bed405ff15542d468831",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0121",
      "section": "04",
      "oldid": 844352,
      "whole_raw_source_SHA256": "5455b60b30f0770ebf8e78e6be715b72c1de2607947bc976476b16e0c49e9bef",
      "whole_raw_source_bytes": 979,
      "anchor_literal": "所生者為化神，化神昌旺，則其氣流行",
      "anchor_character_offset": 250,
      "anchor_UTF8_byte_offset": 526,
      "anchor_UTF8_SHA256": "5561ac718c6dc250422f766e52a7f2de4cf3a0d3f6445f30e4ea126d200baa0e",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0122",
      "section": "04",
      "oldid": 844352,
      "whole_raw_source_SHA256": "5455b60b30f0770ebf8e78e6be715b72c1de2607947bc976476b16e0c49e9bef",
      "whole_raw_source_bytes": 979,
      "anchor_literal": "三合者為全，主旺喜行財旺之地",
      "anchor_character_offset": 308,
      "anchor_UTF8_byte_offset": 650,
      "anchor_UTF8_SHA256": "8647f93e4413cb08696db172f9d8c7f23c8a6e69e9b3c10d05dd5d7e5ab7ac63",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0123",
      "section": "04",
      "oldid": 844352,
      "whole_raw_source_SHA256": "5455b60b30f0770ebf8e78e6be715b72c1de2607947bc976476b16e0c49e9bef",
      "whole_raw_source_bytes": 979,
      "anchor_literal": "形全者宜損其有餘，形缺者宜補其不足",
      "anchor_character_offset": 327,
      "anchor_UTF8_byte_offset": 703,
      "anchor_UTF8_SHA256": "a5d4a70264363f7ea5f1ba1a3c692f55a7c8495456699c6d593db9b74f99ab18",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0124",
      "section": "04",
      "oldid": 844352,
      "whole_raw_source_SHA256": "5455b60b30f0770ebf8e78e6be715b72c1de2607947bc976476b16e0c49e9bef",
      "whole_raw_source_bytes": 979,
      "anchor_literal": "如甲木生於寅卯辰月，丙火生於巳午未月，皆為形全",
      "anchor_character_offset": 349,
      "anchor_UTF8_byte_offset": 765,
      "anchor_UTF8_SHA256": "135255d0f556947d15a9d7fc8213485353b5908fd01b873fb93319f1b9862fd7",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0125",
      "section": "04",
      "oldid": 844352,
      "whole_raw_source_SHA256": "5455b60b30f0770ebf8e78e6be715b72c1de2607947bc976476b16e0c49e9bef",
      "whole_raw_source_bytes": 979,
      "anchor_literal": "戊土生於寅卯辰月，庚金生於巳午未月，皆為形缺",
      "anchor_character_offset": 377,
      "anchor_UTF8_byte_offset": 845,
      "anchor_UTF8_SHA256": "3e3e44cfcea9cc57653745b994f58555efe525e40babc1c3d70fc8b19a356cf3",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0126",
      "section": "05",
      "oldid": 844353,
      "whole_raw_source_SHA256": "df699134405a00601b1d580610413553b8133af312bc8572914960570f51e48a",
      "whole_raw_source_bytes": 1019,
      "anchor_literal": "如寅卯辰，東方也，雜以亥卯未則太過",
      "anchor_character_offset": 87,
      "anchor_UTF8_byte_offset": 137,
      "anchor_UTF8_SHA256": "a68b8c1973125793de2d5c4cb9e58515f1fd4a8b8ea548b83eaa45dd798b026e",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0127",
      "section": "05",
      "oldid": 844353,
      "whole_raw_source_SHA256": "df699134405a00601b1d580610413553b8133af312bc8572914960570f51e48a",
      "whole_raw_source_bytes": 1019,
      "anchor_literal": "如亥卯未木局，混一寅辰，則太強",
      "anchor_character_offset": 155,
      "anchor_UTF8_byte_offset": 291,
      "anchor_UTF8_SHA256": "a49a788d5be994b8386e6ab64a395e437c6ae4b6aefd04f8443ac91077457a41",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0128",
      "section": "05",
      "oldid": 844353,
      "whole_raw_source_SHA256": "df699134405a00601b1d580610413553b8133af312bc8572914960570f51e48a",
      "whole_raw_source_bytes": 1019,
      "anchor_literal": "行運南北，則有純疵，不能俱利",
      "anchor_character_offset": 171,
      "anchor_UTF8_byte_offset": 339,
      "anchor_UTF8_SHA256": "c229348464645d13add1c2a81e8d838caf4d5f2743ca9e9be055f627e1c1a492",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0129",
      "section": "05",
      "oldid": 844353,
      "whole_raw_source_SHA256": "df699134405a00601b1d580610413553b8133af312bc8572914960570f51e48a",
      "whole_raw_source_bytes": 1019,
      "anchor_literal": "如木局木方齊來，須要天干順序，行運不悖",
      "anchor_character_offset": 229,
      "anchor_UTF8_byte_offset": 463,
      "anchor_UTF8_SHA256": "cbafb51a52181bf062c92fd4f8037112171e003c5004160f9f47d9d81d3465cb",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0130",
      "section": "05",
      "oldid": 844353,
      "whole_raw_source_SHA256": "df699134405a00601b1d580610413553b8133af312bc8572914960570f51e48a",
      "whole_raw_source_bytes": 1019,
      "anchor_literal": "如寅卯辰全，而又乾透甲乙一元神，復又遇亥之生，未之庫，決不發福",
      "anchor_character_offset": 292,
      "anchor_UTF8_byte_offset": 602,
      "anchor_UTF8_SHA256": "7c659d9598ba8bf9791e18279a3a825de3d95437487f0a99bd622d15d0326b9b",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0131",
      "section": "05",
      "oldid": 844353,
      "whole_raw_source_SHA256": "df699134405a00601b1d580610413553b8133af312bc8572914960570f51e48a",
      "whole_raw_source_bytes": 1019,
      "anchor_literal": "如甲乙日遇亥卯未全，而又乾透庚辛一官星，又見右寅，左辰，則名利無成",
      "anchor_character_offset": 375,
      "anchor_UTF8_byte_offset": 801,
      "anchor_UTF8_SHA256": "659ec354f5a9fe5bba5dd11cbf63e0a72bd56b61c540d2d11770fa791d7ce4a4",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0132",
      "section": "07",
      "oldid": 844355,
      "whole_raw_source_SHA256": "f4b092b4fc39897ca4ff1a356861d8e787cb87360bccf80bbcd851acc496fe55",
      "whole_raw_source_bytes": 1142,
      "anchor_literal": "日主孤弱無氣，天地人三元，絕無一毫生扶之意，財官等強甚，乃為真從也",
      "anchor_character_offset": 89,
      "anchor_UTF8_byte_offset": 143,
      "anchor_UTF8_SHA256": "592db0a2371680ff676d3ccc3d4a91b44252cfbfbde5fa258be1c2dda511e6bd",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0133",
      "section": "07",
      "oldid": 844355,
      "whole_raw_source_SHA256": "f4b092b4fc39897ca4ff1a356861d8e787cb87360bccf80bbcd851acc496fe55",
      "whole_raw_source_bytes": 1142,
      "anchor_literal": "既從矣，當論所從之神",
      "anchor_character_offset": 123,
      "anchor_UTF8_byte_offset": 245,
      "anchor_UTF8_SHA256": "ba7953727278879ce02dcbdc9b6598656bcc4188091533a5d2d0b6733300b552",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0134",
      "section": "07",
      "oldid": 844355,
      "whole_raw_source_SHA256": "f4b092b4fc39897ca4ff1a356861d8e787cb87360bccf80bbcd851acc496fe55",
      "whole_raw_source_bytes": 1142,
      "anchor_literal": "如從財則以財為主，財神是木，又看意向，或要火，或要土",
      "anchor_character_offset": 134,
      "anchor_UTF8_byte_offset": 278,
      "anchor_UTF8_SHA256": "1629e02a45b3e0646fabba0b07721a7b195cd68a802b81043776caf38427648d",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0135",
      "section": "07",
      "oldid": 844355,
      "whole_raw_source_SHA256": "f4b092b4fc39897ca4ff1a356861d8e787cb87360bccf80bbcd851acc496fe55",
      "whole_raw_source_bytes": 1142,
      "anchor_literal": "如甲日主，生於四季，單遇一位己土，在月時上作合，（在年幹不是）不遇壬癸甲乙庚（印，劫，官），乃為化得真",
      "anchor_character_offset": 223,
      "anchor_UTF8_byte_offset": 495,
      "anchor_UTF8_SHA256": "12cad579f40e16c54e4da348aa3e46c9cf93fe27feaeb6da5b35e7f55b5f84e7",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0136",
      "section": "07",
      "oldid": 844355,
      "whole_raw_source_SHA256": "f4b092b4fc39897ca4ff1a356861d8e787cb87360bccf80bbcd851acc496fe55",
      "whole_raw_source_bytes": 1142,
      "anchor_literal": "（化神要通月令）",
      "anchor_character_offset": 290,
      "anchor_UTF8_byte_offset": 696,
      "anchor_UTF8_SHA256": "ef1d3487604aa1cbec0b193eef5e6ce5c1116531341621e2ad62f815bd6f2456",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0137",
      "section": "07",
      "oldid": 844355,
      "whole_raw_source_SHA256": "f4b092b4fc39897ca4ff1a356861d8e787cb87360bccf80bbcd851acc496fe55",
      "whole_raw_source_bytes": 1142,
      "anchor_literal": "甲己化土，土遇陰寒，要火為印",
      "anchor_character_offset": 339,
      "anchor_UTF8_byte_offset": 843,
      "anchor_UTF8_SHA256": "e59091a77a05dcd845becfa9476f8d6531bb971a6855190f980a6ef0ebbf4c26",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0138",
      "section": "07",
      "oldid": 844355,
      "whole_raw_source_SHA256": "f4b092b4fc39897ca4ff1a356861d8e787cb87360bccf80bbcd851acc496fe55",
      "whole_raw_source_bytes": 1142,
      "anchor_literal": "如土太旺，又要水為財，木為官，金為食傷",
      "anchor_character_offset": 354,
      "anchor_UTF8_byte_offset": 888,
      "anchor_UTF8_SHA256": "3a01cf423f88a6402e3d5236e811984abb9638f31af03eaeb75b1b26cf6dedef",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0139",
      "section": "08",
      "oldid": 844356,
      "whole_raw_source_SHA256": "7264788dac3dc81bd84396b848adcde978407146d44e642025bcded785aa1d7b",
      "whole_raw_source_bytes": 710,
      "anchor_literal": "日主弱矣，財官強矣，不能不從，中有所助者，便假",
      "anchor_character_offset": 89,
      "anchor_UTF8_byte_offset": 143,
      "anchor_UTF8_SHA256": "4b88bb94e85de31edcd05517d97fdd7a1c8b8d2394261f01a147c67f3f2f3b43",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0140",
      "section": "08",
      "oldid": 844356,
      "whole_raw_source_SHA256": "7264788dac3dc81bd84396b848adcde978407146d44e642025bcded785aa1d7b",
      "whole_raw_source_bytes": 710,
      "anchor_literal": "至於行運，財官得地，雖是假從，亦可富貴",
      "anchor_character_offset": 113,
      "anchor_UTF8_byte_offset": 215,
      "anchor_UTF8_SHA256": "c2a6b9b998c82bce58f0506050d1e9eb3ae460d85d9f96c327ddaaeafeda72e9",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0141",
      "section": "08",
      "oldid": 844356,
      "whole_raw_source_SHA256": "7264788dac3dc81bd84396b848adcde978407146d44e642025bcded785aa1d7b",
      "whole_raw_source_bytes": 710,
      "anchor_literal": "但其人不能免禍，或心術不端耳",
      "anchor_character_offset": 133,
      "anchor_UTF8_byte_offset": 275,
      "anchor_UTF8_SHA256": "9a235c1ac68a1864dff1b33896c744899fb88681b0f352298097e15b19d590db",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0142",
      "section": "08",
      "oldid": 844356,
      "whole_raw_source_SHA256": "7264788dac3dc81bd84396b848adcde978407146d44e642025bcded785aa1d7b",
      "whole_raw_source_bytes": 710,
      "anchor_literal": "日主孤弱，而遇合神，不能不化，但有暗扶日主，如合神虛弱，則化不真",
      "anchor_character_offset": 191,
      "anchor_UTF8_byte_offset": 399,
      "anchor_UTF8_SHA256": "cc72d44d41c4090e84c0b26db5adabb23924a2a69c306a8af0d1a233436f0ef4",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0143",
      "section": "08",
      "oldid": 844356,
      "whole_raw_source_SHA256": "7264788dac3dc81bd84396b848adcde978407146d44e642025bcded785aa1d7b",
      "whole_raw_source_bytes": 710,
      "anchor_literal": "至歲運扶起合神，制伏忌神，雖為假化，亦可取用",
      "anchor_character_offset": 224,
      "anchor_UTF8_byte_offset": 498,
      "anchor_UTF8_SHA256": "19f9253a10b09930a5f6dcc5f0a4fc815d3a9ccf0ba5b1d358f31330daab22e3",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0144",
      "section": "08",
      "oldid": 844356,
      "whole_raw_source_SHA256": "7264788dac3dc81bd84396b848adcde978407146d44e642025bcded785aa1d7b",
      "whole_raw_source_bytes": 710,
      "anchor_literal": "異姓孤兒，亦能出類，但其人多執滯偏拗",
      "anchor_character_offset": 247,
      "anchor_UTF8_byte_offset": 567,
      "anchor_UTF8_SHA256": "26d48aa1f8474a661011f1b27188f2f4e14d6e96c85c77f18b9eb0c8ef74b949",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0145",
      "section": "11",
      "oldid": 844359,
      "whole_raw_source_SHA256": "25de00a87d15b15339eff5d4c70e2c44c4aaaf05f78df50c0b763f1e96a18b51",
      "whole_raw_source_bytes": 727,
      "anchor_literal": "五行大率以金水為精氣，木火為神氣，而土所以實之者也",
      "anchor_character_offset": 94,
      "anchor_UTF8_byte_offset": 158,
      "anchor_UTF8_SHA256": "fbfb55f1f009a4220b4455c58b3f9a402fcc33c068c2ad08584618eca2559d33",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0146",
      "section": "11",
      "oldid": 844359,
      "whole_raw_source_SHA256": "25de00a87d15b15339eff5d4c70e2c44c4aaaf05f78df50c0b763f1e96a18b51",
      "whole_raw_source_bytes": 727,
      "anchor_literal": "有精足不見其神，而神自足者",
      "anchor_character_offset": 134,
      "anchor_UTF8_byte_offset": 278,
      "anchor_UTF8_SHA256": "1430227d7c686ee6f9c36e3ae1b3fd70a47cc8bd330804a124a9d06bfe0858c0",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0147",
      "section": "11",
      "oldid": 844359,
      "whole_raw_source_SHA256": "25de00a87d15b15339eff5d4c70e2c44c4aaaf05f78df50c0b763f1e96a18b51",
      "whole_raw_source_bytes": 727,
      "anchor_literal": "有精缺神索而日主孤弱者",
      "anchor_character_offset": 148,
      "anchor_UTF8_byte_offset": 320,
      "anchor_UTF8_SHA256": "c528b1f538f05b06b2c47928dbbdc396c323c4c6e548a3d12681bcf5b9c8987d",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0148",
      "section": "11",
      "oldid": 844359,
      "whole_raw_source_SHA256": "25de00a87d15b15339eff5d4c70e2c44c4aaaf05f78df50c0b763f1e96a18b51",
      "whole_raw_source_bytes": 727,
      "anchor_literal": "凡此不可以一偏求之，俱要損益其進退",
      "anchor_character_offset": 239,
      "anchor_UTF8_byte_offset": 593,
      "anchor_UTF8_SHA256": "5caa3350660667fbbf58fb5f2ef13d5501ac46932ca39458027c2bcd7e732593",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0149",
      "section": "12",
      "oldid": 844360,
      "whole_raw_source_SHA256": "c17a857454f0e545b63c90dac9ddac0361d61cfe07718f7a5a793b4a2ff2ec80",
      "whole_raw_source_bytes": 547,
      "anchor_literal": "旺則宜洩宜傷，衰則喜幫喜助",
      "anchor_character_offset": 91,
      "anchor_UTF8_byte_offset": 149,
      "anchor_UTF8_SHA256": "cdbae7b5ebf920d04ddc572602c03039af45978c5760df673415a7360a86b9d1",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0150",
      "section": "12",
      "oldid": 844360,
      "whole_raw_source_SHA256": "c17a857454f0e545b63c90dac9ddac0361d61cfe07718f7a5a793b4a2ff2ec80",
      "whole_raw_source_bytes": 547,
      "anchor_literal": "旺中有衰者存，不可損也",
      "anchor_character_offset": 112,
      "anchor_UTF8_byte_offset": 212,
      "anchor_UTF8_SHA256": "26a20ac23f493ffdd63f415a582e2f96bb0047525883152341bb9134bf54398b",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0151",
      "section": "12",
      "oldid": 844360,
      "whole_raw_source_SHA256": "c17a857454f0e545b63c90dac9ddac0361d61cfe07718f7a5a793b4a2ff2ec80",
      "whole_raw_source_bytes": 547,
      "anchor_literal": "衰中有旺者存，不可益也",
      "anchor_character_offset": 124,
      "anchor_UTF8_byte_offset": 248,
      "anchor_UTF8_SHA256": "5b8db6c204e0c6500f829cc70ddd6eb17479549bf54811e5a3abf446bc69f382",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0152",
      "section": "12",
      "oldid": 844360,
      "whole_raw_source_SHA256": "c17a857454f0e545b63c90dac9ddac0361d61cfe07718f7a5a793b4a2ff2ec80",
      "whole_raw_source_bytes": 547,
      "anchor_literal": "旺之極者不可損，以損在其中矣",
      "anchor_character_offset": 136,
      "anchor_UTF8_byte_offset": 284,
      "anchor_UTF8_SHA256": "27a6ebca51cf8bed6e2ecc5c8cc990ef603a815fbde0df794b226dc88e33ee35",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0153",
      "section": "12",
      "oldid": 844360,
      "whole_raw_source_SHA256": "c17a857454f0e545b63c90dac9ddac0361d61cfe07718f7a5a793b4a2ff2ec80",
      "whole_raw_source_bytes": 547,
      "anchor_literal": "衰之極者不可益，以在其中矣",
      "anchor_character_offset": 151,
      "anchor_UTF8_byte_offset": 329,
      "anchor_UTF8_SHA256": "36f3e978ddf05f54afdcb574ccc3ff3963587772116a71f9ed333620c33965c3",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    },
    {
      "id": "BZI-R0154",
      "section": "12",
      "oldid": 844360,
      "whole_raw_source_SHA256": "c17a857454f0e545b63c90dac9ddac0361d61cfe07718f7a5a793b4a2ff2ec80",
      "whole_raw_source_bytes": 547,
      "anchor_literal": "至於所當損者而損之反凶，所當益者而益之反害",
      "anchor_character_offset": 165,
      "anchor_UTF8_byte_offset": 371,
      "anchor_UTF8_SHA256": "1b4c14438f420d8f44d896f1b5a449fac25ff1133425a0ad01db7f844332413a",
      "source_verse_or_commentary": "TRANSMITTED_COMMENTARY_UNDATED"
    }
  ]
}
