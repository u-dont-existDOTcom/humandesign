      "source_type": "SOURCE_SECTION_HEADING",
      "source_original_exact_Chinese_quote": "===四子女===",
      "quote_SHA256": "cf564afc92a94a5bd2355246df09d02ee08d8cabcc09b02f7d1eea4d20b50082",
      "quote_UTF8_bytes": 15,
      "absolute_codepoint_offset": 39218,
