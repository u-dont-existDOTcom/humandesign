      "original_line_index": 0,
      "historic_reproductive_health_family_welfare_stereotypes_present": true,
      "original_Ming_printing_independently_authenticated": false,
      "independent_human_blind_predictive_validations": 0,
      "runtime_astrological_promotions": 0
    },
    {
      "id": "ZWD-R0796",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-19SRC-Children",
      "original_source_revision": 1963110,
      "full_original_Wikitext_SHA256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_source_group": "ChildrenMethodPreamble",
      "source_type": "SOURCE_METHOD_AND_CONDITION_PREMISE",
      "source_original_exact_Chinese_quote": "凡看子女先看本宫星宿主有几子。若加羊陀火玲空劫杀忌主生子女有刑克，次看对宫有冲刑否。",
      "quote_SHA256": "6668bdf1362949ef19bc9c31b3e5b9580037bc4c5b89052f4d133e008e68f311",
      "quote_UTF8_bytes": 126,
      "absolute_codepoint_offset": 39235,
      "absolute_UTF8_byte_offset": 79667,
      "excerpt_relative_codepoint_offset": 17,
      "original_line_index": 1,
      "historic_reproductive_health_family_welfare_stereotypes_present": true,
      "original_Ming_printing_independently_authenticated": false,
      "independent_human_blind_predictive_validations": 0,
      "runtime_astrological_promotions": 0
    },
    {
      "id": "ZWD-R0797",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-19SRC-Children",
      "original_source_revision": 1963110,
      "full_original_Wikitext_SHA256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_source_group": "ChildrenMethodPreamble",
      "source_type": "SOURCE_METHOD_AND_CONDITION_PREMISE",
      "source_original_exact_Chinese_quote": "如本宫无星曜专看对宫有何星宿主有几子。若善星贵星守子女宫必主其人生子昌盛贵显。若恶星又同刑杀守子女宫，不是刑克，主生强横破荡之子。",
      "quote_SHA256": "2e3a2caa084013fc1be2abad498aab79d87d62f558331b0a43d7bc85950671b9",
      "quote_UTF8_bytes": 195,
      "absolute_codepoint_offset": 39278,
      "absolute_UTF8_byte_offset": 79794,
      "excerpt_relative_codepoint_offset": 60,
      "original_line_index": 2,
      "historic_reproductive_health_family_welfare_stereotypes_present": true,
      "original_Ming_printing_independently_authenticated": false,
      "independent_human_blind_predictive_validations": 0,
      "runtime_astrological_promotions": 0
    },
    {
      "id": "ZWD-R0798",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-19SRC-Children",
      "original_source_revision": 1963110,
      "full_original_Wikitext_SHA256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_source_group": "ChildrenMethodPreamble",
      "source_type": "SOURCE_METHOD_AND_CONDITION_PREMISE",
      "source_original_exact_Chinese_quote": "又看三方四正得南斗星多主生男，北斗星多主生女。若太阳星落在阳宫主先生男，太阴星落在阴宫主先生女。",
      "quote_SHA256": "304427d420e90a2e2d527e3a4a02e9ea5605fd193708037a73db060ea6bcc0e1",
      "quote_UTF8_bytes": 144,
      "absolute_codepoint_offset": 39344,
      "absolute_UTF8_byte_offset": 79990,
      "excerpt_relative_codepoint_offset": 126,
      "original_line_index": 3,
      "historic_reproductive_health_family_welfare_stereotypes_present": true,
      "original_Ming_printing_independently_authenticated": false,
      "independent_human_blind_predictive_validations": 0,
      "runtime_astrological_promotions": 0
    },
    {
      "id": "ZWD-R0799",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-19SRC-Children",
      "original_source_revision": 1963110,
      "full_original_Wikitext_SHA256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_source_group": "ChildrenMethodPreamble",
      "source_type": "SOURCE_METHOD_AND_CONDITION_PREMISE",
      "source_original_exact_Chinese_quote": "专看刑杀守本宫无制化相生，必然绝祀。日生最怕太阴临，夜生最怕太阳照，此星若在儿女宫方恐无儿。",
      "quote_SHA256": "6a8906d0c4a10635e4e469a6f7af8cf758c5a503796a4c76bfa411d62306611f",
      "quote_UTF8_bytes": 138,
      "absolute_codepoint_offset": 39393,
      "absolute_UTF8_byte_offset": 80135,
      "excerpt_relative_codepoint_offset": 175,
      "original_line_index": 4,
      "historic_reproductive_health_family_welfare_stereotypes_present": true,
      "original_Ming_printing_independently_authenticated": false,
      "independent_human_blind_predictive_validations": 0,
      "runtime_astrological_promotions": 0
    },
    {
      "id": "ZWD-R0800",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-19SRC-Children",
      "original_source_revision": 1963110,
      "full_original_Wikitext_SHA256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_source_group": "ZiWei",
      "source_type": "SOURCE_STAR_PROFILE_OR_COMBINED_RULE_LINE",
      "source_original_exact_Chinese_quote": "紫微庙旺男三女二，加左右昌曲有五人，加羊陀火铃空劫只一双，不然偏室生者多，或招祀子居长，破军同三人，",
      "quote_SHA256": "62f04af2679cb19641df37f6b82a54f3c4197afa08fafcc5982c7dd3df47c399",
      "quote_UTF8_bytes": 150,
      "absolute_codepoint_offset": 39442,
      "absolute_UTF8_byte_offset": 80276,
      "excerpt_relative_codepoint_offset": 224,
      "original_line_index": 5,
      "historic_reproductive_health_family_welfare_stereotypes_present": true,
      "original_Ming_printing_independently_authenticated": false,
      "independent_human_blind_predictive_validations": 0,
      "runtime_astrological_promotions": 0
    },
    {
      "id": "ZWD-R0801",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-19SRC-Children",
      "original_source_revision": 1963110,
      "full_original_Wikitext_SHA256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_source_group": "ZiWei",
      "source_type": "SOURCE_CONTINUED_PREVIOUS_STAR_PROFILE_LINE",
      "source_original_exact_Chinese_quote": "天府同加吉星四五人，加昌曲左右有贵子，若独守再加空劫孤君。",
      "quote_SHA256": "8432127e8759526378d5675982208a70bd7bb233e4313b670f7af3275606a9d9",
      "quote_UTF8_bytes": 87,
      "absolute_codepoint_offset": 39493,
      "absolute_UTF8_byte_offset": 80427,
      "excerpt_relative_codepoint_offset": 275,
      "original_line_index": 6,
      "historic_reproductive_health_family_welfare_stereotypes_present": true,
      "original_Ming_printing_independently_authenticated": false,
      "independent_human_blind_predictive_validations": 0,
      "runtime_astrological_promotions": 0
    },
    {
      "id": "ZWD-R0802",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-19SRC-Children",
      "original_source_revision": 1963110,
      "full_original_Wikitext_SHA256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_source_group": "TianJi",
      "source_type": "SOURCE_STAR_PROFILE_OR_COMBINED_RULE_LINE",
      "source_original_exact_Chinese_quote": "天机庙旺二人，或庶生多，巨门一人，天梁同在寅宫，有二三人，在申宫女多男少，只可一子，太阴同二三人，加羊陀火铃空劫全无子。",
      "quote_SHA256": "2a074c3a4ef56d6a34dba92b24b21b681a4f06655a66b8cf856f6f8bf5bd5da3",
      "quote_UTF8_bytes": 180,
      "absolute_codepoint_offset": 39525,
      "absolute_UTF8_byte_offset": 80517,
      "excerpt_relative_codepoint_offset": 307,
      "original_line_index": 7,
      "historic_reproductive_health_family_welfare_stereotypes_present": true,
      "original_Ming_printing_independently_authenticated": false,
      "independent_human_blind_predictive_validations": 0,
      "runtime_astrological_promotions": 0
    },
    {
      "id": "ZWD-R0803",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-19SRC-Children",
      "original_source_revision": 1963110,
      "full_original_Wikitext_SHA256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_source_group": "TaiYang",
      "source_type": "SOURCE_STAR_PROFILE_OR_COMBINED_RULE_LINE",
      "source_original_exact_Chinese_quote": "太阳入庙男三女二晚子贵，巨门同三人，太阴同五人，陷地有三子不成盖，再加羊陀火铃空劫止留一子送终。",
      "quote_SHA256": "850802a1a16697a124cfa7c8933d8543ec4189250448eb6cd4b9c529e3a1473c",
      "quote_UTF8_bytes": 144,
      "absolute_codepoint_offset": 39588,
      "absolute_UTF8_byte_offset": 80700,
      "excerpt_relative_codepoint_offset": 370,
      "original_line_index": 8,
      "historic_reproductive_health_family_welfare_stereotypes_present": true,
      "original_Ming_printing_independently_authenticated": false,
      "independent_human_blind_predictive_validations": 0,
      "runtime_astrological_promotions": 0
    },
    {
      "id": "ZWD-R0804",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-19SRC-Children",
      "original_source_revision": 1963110,
      "full_original_Wikitext_SHA256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_source_group": "WuQu",
      "source_type": "SOURCE_STAR_PROFILE_OR_COMBINED_RULE_LINE",
      "source_original_exact_Chinese_quote": "武曲主一子或成至生者多，破军同主刑，止有一人，加羊陀火铃空劫绝祀，贪狼晚招二子，天相同先招外子，后亲生一子，七杀同主孤或伤残之子。",
      "quote_SHA256": "e5cd901b02aa554d601c1ba010a9f052f882d049038c88b0b4ec256efc566511",
      "quote_UTF8_bytes": 195,
      "absolute_codepoint_offset": 39639,
      "absolute_UTF8_byte_offset": 80847,
      "excerpt_relative_codepoint_offset": 421,
      "original_line_index": 9,
      "historic_reproductive_health_family_welfare_stereotypes_present": true,
      "original_Ming_printing_independently_authenticated": false,
      "independent_human_blind_predictive_validations": 0,
      "runtime_astrological_promotions": 0
    },
    {
      "id": "ZWD-R0805",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-19SRC-Children",
      "original_source_revision": 1963110,
      "full_original_Wikitext_SHA256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_source_group": "TianTong",
      "source_type": "SOURCE_STAR_PROFILE_OR_COMBINED_RULE_LINE",
      "source_original_exact_Chinese_quote": "天同庙旺五子有贵，巨门同三人，太阴同五人，在午宫陷地减半，天梁同先女后男有二子，守在申宫只可留一子送终，",
      "quote_SHA256": "88809f1c3d4364d644d7d4bbb61d9ebd590cb9d611e29b420e01d40981adf8a3",
      "quote_UTF8_bytes": 156,
      "absolute_codepoint_offset": 39707,
      "absolute_UTF8_byte_offset": 81045,
      "excerpt_relative_codepoint_offset": 489,
      "original_line_index": 10,
      "historic_reproductive_health_family_welfare_stereotypes_present": true,
      "original_Ming_printing_independently_authenticated": false,
      "independent_human_blind_predictive_validations": 0,
      "runtime_astrological_promotions": 0
    },
    {
      "id": "ZWD-R0806",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-19SRC-Children",
      "original_source_revision": 1963110,
      "full_original_Wikitext_SHA256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_source_group": "TianTong",
      "source_type": "SOURCE_CONTINUED_PREVIOUS_STAR_PROFILE_LINE",
      "source_original_exact_Chinese_quote": "在寅宫加吉星有三子，加羊陀火铃空劫见刑克，子少送终。",
      "quote_SHA256": "12511b49a86213d5a20c5b99d182691d614425a27a57b6dad45df9db0e601e06",
      "quote_UTF8_bytes": 78,
      "absolute_codepoint_offset": 39760,
      "absolute_UTF8_byte_offset": 81202,
      "excerpt_relative_codepoint_offset": 542,
      "original_line_index": 11,
      "historic_reproductive_health_family_welfare_stereotypes_present": true,
      "original_Ming_printing_independently_authenticated": false,
      "independent_human_blind_predictive_validations": 0,
      "runtime_astrological_promotions": 0
    },
    {
      "id": "ZWD-R0807",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-19SRC-Children",
      "original_source_revision": 1963110,
      "full_original_Wikitext_SHA256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_source_group": "LianZhen",
      "source_type": "SOURCE_STAR_PROFILE_OR_COMBINED_RULE_LINE",
      "source_original_exact_Chinese_quote": "廉贞一人，天府同主贵子三人，若贪狼破军七杀同主孤，再加羊陀火铃空劫全无，天相同有二子。",
      "quote_SHA256": "6ac5882d093fb1188819ce430e4bf07a32501795db0895b720cc6985d5d6c246",
      "quote_UTF8_bytes": 129,
      "absolute_codepoint_offset": 39789,
      "absolute_UTF8_byte_offset": 81283,
      "excerpt_relative_codepoint_offset": 571,
      "original_line_index": 12,
      "historic_reproductive_health_family_welfare_stereotypes_present": true,
      "original_Ming_printing_independently_authenticated": false,
      "independent_human_blind_predictive_validations": 0,
      "runtime_astrological_promotions": 0
    },
    {
      "id": "ZWD-R0808",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-19SRC-Children",
      "original_source_revision": 1963110,
      "full_original_Wikitext_SHA256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_source_group": "TianFu",
      "source_type": "SOURCE_STAR_PROFILE_OR_COMBINED_RULE_LINE",
      "source_original_exact_Chinese_quote": "天府五人，武曲同二人，紫微同四五人，廉贞同三人，加羊陀火铃空劫止三人。",
      "quote_SHA256": "0a71b11871764351469e71c91c8eb3c8d600cfb332110448c65e1b59a4eabe66",
      "quote_UTF8_bytes": 105,
      "absolute_codepoint_offset": 39835,
      "absolute_UTF8_byte_offset": 81415,
      "excerpt_relative_codepoint_offset": 617,
      "original_line_index": 13,
      "historic_reproductive_health_family_welfare_stereotypes_present": false,
      "original_Ming_printing_independently_authenticated": false,
      "independent_human_blind_predictive_validations": 0,
      "runtime_astrological_promotions": 0
    },
    {
      "id": "ZWD-R0809",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-19SRC-Children",
      "original_source_revision": 1963110,
      "full_original_Wikitext_SHA256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_source_group": "TaiYin",
      "source_type": "SOURCE_STAR_PROFILE_OR_COMBINED_RULE_LINE",
      "source_original_exact_Chinese_quote": "太阴女三男二先女后男，庙旺有贵子，陷地减半，招软弱之子，或虚花不成器，",
      "quote_SHA256": "49eb3d7e8e95ed69d675cb5a58b099e627e726796e42cd68b06739d78a10b499",
      "quote_UTF8_bytes": 105,
      "absolute_codepoint_offset": 39873,
      "absolute_UTF8_byte_offset": 81523,
      "excerpt_relative_codepoint_offset": 655,
      "original_line_index": 14,
      "historic_reproductive_health_family_welfare_stereotypes_present": true,
      "original_Ming_printing_independently_authenticated": false,
      "independent_human_blind_predictive_validations": 0,
      "runtime_astrological_promotions": 0
    },
    {
      "id": "ZWD-R0810",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-19SRC-Children",
      "original_source_revision": 1963110,
      "full_original_Wikitext_SHA256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_source_group": "TaiYin",
      "source_type": "SOURCE_CONTINUED_PREVIOUS_STAR_PROFILE_LINE",
      "source_original_exact_Chinese_quote": "太阳同五人，天机同二人，天同同五人，庙地无克，陷宫有克，加羊陀火铃空劫子少。",
      "quote_SHA256": "596911240123ed62d3a711bd254794fbaf41b146cc0c92543cb4dba8eb795a30",
      "quote_UTF8_bytes": 114,
      "absolute_codepoint_offset": 39909,
      "absolute_UTF8_byte_offset": 81629,
      "excerpt_relative_codepoint_offset": 691,
      "original_line_index": 15,
      "historic_reproductive_health_family_welfare_stereotypes_present": true,
      "original_Ming_printing_independently_authenticated": false,
      "independent_human_blind_predictive_validations": 0,
      "runtime_astrological_promotions": 0
    },
    {
      "id": "ZWD-R0811",
      "source": "ZWDS-CLASSIC-01",
      "batch": "ChineseAstro-19SRC-Children",
      "original_source_revision": 1963110,
      "full_original_Wikitext_SHA256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_source_group": "TanLang",
      "source_type": "SOURCE_STAR_PROFILE_OR_COMBINED_RULE_LINE",
      "source_original_exact_Chinese_quote": "贪狼庙旺二人，早有刑克，紫微同二人，廉贞同子少，如占星二人，武曲同三人，先难后易。",
      "quote_SHA256": "2fdde8ab37167f5a29338703343296befcbc017bb7308d3fbc669257d6d82331",
      "quote_UTF8_bytes": 123,
      "absolute_codepoint_offset": 39950,
