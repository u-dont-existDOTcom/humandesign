      "original_codepoint_offset": 4263,
      "relative_excerpt_codepoint_offset": 260,
      "verbatim_chinese": "坎水宫中二岁行，初一起丑初二寅，\n顺行一宫安二日，阴阳虽殊行则同。",
      "utf8_quote_sha256": "dd512c04f2b0ebe0dceed7409e352a3c6cebed9d1b2f9a8fd50d1e05c179373c",
      "original_full_source_byte_offset": 11447,
      "source_type": "bureau_poem",
      "original_daygrid_full_sha256": null
    },
    {
      "id": "ZWD-R0193",
      "full_original_source_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_codepoint_offset": 5052,
      "relative_excerpt_codepoint_offset": 1049,
      "verbatim_chinese": "水二局",
      "utf8_quote_sha256": "b9c377c14aadb4d917e5bb21142ca2a5c009db054d14e04bc7ff063b26942567",
      "original_full_source_byte_offset": 12364,
      "source_type": "bureau_original_grid",
      "original_daygrid_full_sha256": "e87516e6c9d75133ce8be8ea4b4cba8b87f446f748517a78b13a6bbc9b4c477f"
    },
    {
      "id": "ZWD-R0194",
      "full_original_source_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_codepoint_offset": 5804,
      "relative_excerpt_codepoint_offset": 1801,
      "verbatim_chinese": "生逢木宫三岁起，初一起龙初二牛，\n逆进二宫安二日，顺回四步一辰字，\n初二同宫牛头起，逆退二步二辰寻。",
      "utf8_quote_sha256": "f5427d1658ae255ad953caaf3412067f582093f6563e00c14f558cfd49732e82",
      "original_full_source_byte_offset": 13202,
      "source_type": "bureau_poem",
      "original_daygrid_full_sha256": null
    },
    {
      "id": "ZWD-R0195",
      "full_original_source_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_codepoint_offset": 6600,
      "relative_excerpt_codepoint_offset": 2597,
      "verbatim_chinese": "木三局",
      "utf8_quote_sha256": "8216e83de00237a640d110de585ebe952aedbe8383075e4c480dd13cb68a6148",
      "original_full_source_byte_offset": 14178,
      "source_type": "bureau_original_grid",
      "original_daygrid_full_sha256": "5df4c5ac8e0217e0773f4e1dd3d45270b9b928199703f484f669d814e3521859"
    },
    {
      "id": "ZWD-R0196",
      "full_original_source_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_codepoint_offset": 7362,
      "relative_excerpt_codepoint_offset": 3359,
      "verbatim_chinese": "紫微金宫四岁花，初一寻猪初二龙，\n顺进三步逆退一，先阴后阳是其基，\n惟有初二辰上起，退三进四逆寻迹。",
      "utf8_quote_sha256": "ec7d6d9d0c74f256a4f5c92d13ddcfd3e045f3f552558ab2abf3c47aeb9e0ec3",
      "original_full_source_byte_offset": 15006,
      "source_type": "bureau_poem",
      "original_daygrid_full_sha256": null
    },
    {
      "id": "ZWD-R0197",
      "full_original_source_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_codepoint_offset": 8158,
      "relative_excerpt_codepoint_offset": 4155,
      "verbatim_chinese": "金四局",
      "utf8_quote_sha256": "7f80349ac661ddee3ae04a0b15780f35618e9f1847c764503a1025bed304b219",
      "original_full_source_byte_offset": 15982,
      "source_type": "bureau_original_grid",
      "original_daygrid_full_sha256": "7eef0a0fe6bee8b4fe53e0eb88580f383ab1c1436027bd96bc97cbb8c5c8dbb7"
    },
    {
      "id": "ZWD-R0198",
      "full_original_source_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_codepoint_offset": 8922,
      "relative_excerpt_codepoint_offset": 4919,
      "verbatim_chinese": "戌土五龙居其中，初一午上二亥宫，\n逆行二宫安一日，惟有九日不能均，\n十居辰上初居寅，二十九日五上寻，\n二宫一日顺三次，退二三次又逆回，\n惟有六日无正位，逢四对宫去追寻。",
      "utf8_quote_sha256": "2671c3a95867aec86f82fc700af9b844a14e37b05c1f7cafd1b3cd9dc23e6e15",
      "original_full_source_byte_offset": 16808,
      "source_type": "bureau_poem",
      "original_daygrid_full_sha256": null
    },
    {
      "id": "ZWD-R0199",
      "full_original_source_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_codepoint_offset": 9752,
      "relative_excerpt_codepoint_offset": 5749,
      "verbatim_chinese": "土五局",
      "utf8_quote_sha256": "28233163c3a1f9224a4222beb4f8e9e259b61542b89c21708140d53381c3975e",
      "original_full_source_byte_offset": 17882,
      "source_type": "bureau_original_grid",
      "original_daygrid_full_sha256": "ee04e1c71eac992601876950e0f2681ca12f8b9cc08634eff69a3154c3c357b6"
    },
    {
      "id": "ZWD-R0200",
      "full_original_source_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_codepoint_offset": 10514,
      "relative_excerpt_codepoint_offset": 6511,
      "verbatim_chinese": "离火宫中六岁奇，初二骑马初四龙，\n进三退二各一日，逆回三步是生时，\n先阳后阴逆退二，另有进一各期端，\n退二安一退二日，顺进五宫方是基。",
      "utf8_quote_sha256": "130f13558ffdbe912a0218028c5a81300f1e5db3abf7f414423f60974af8521e",
      "original_full_source_byte_offset": 18710,
      "source_type": "bureau_poem",
      "original_daygrid_full_sha256": null
    },
