      "relative_excerpt_codepoint_offset": 229,
      "verbatim_chinese": "丧门木",
      "utf8_quote_sha256": "a00e7bf32dc0012e51a9e26c012a718af9bed9398a30fa40b8b584a1047d7cdf",
      "original_full_source_byte_offset": 11392,
