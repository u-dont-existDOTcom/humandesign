    {
      "id": "ZWD-R0191",
      "full_original_source_sha256": "1e255c6ae99e6f89ae124ab342554ef1347fc8e68fb8908cba7290d1a38cbb72",
      "original_codepoint_offset": 4244,
      "relative_excerpt_codepoint_offset": 241,
      "verbatim_chinese": "官符火",
      "utf8_quote_sha256": "761a637914d7e40316cceacdc443a1ab80f185ce6d8e052a1d9704a217e45056",
      "original_full_source_byte_offset": 11422,
      "source_type": "aux_star",
      "original_daygrid_full_sha256": null
