      "original_codepoint_offset": 11333,
      "relative_excerpt_codepoint_offset": 7330,
      "verbatim_chinese": "火六局",
      "utf8_quote_sha256": "5300663fd9bf968d88fd9cb8d20ea1ba960f45dc0b6fc016a2a7fd6c2adc1eb1",
      "original_full_source_byte_offset": 19729,
      "source_type": "bureau_original_grid",
