{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "/bin/sh -c \"exec python -m uvicorn hdmatch.api.relationship_llm_jsonmode_app:create_relationship_llm_jsonmode_app_from_env --factory --host 0.0.0.0 --port $PORT\"",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
