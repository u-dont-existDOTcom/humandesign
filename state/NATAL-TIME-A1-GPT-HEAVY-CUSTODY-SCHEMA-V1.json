  "x-scope": "SYNTHETIC_METADATA_ONLY_NO_HUMAN_FACING_OR_SEMANTIC_CONTENT",
  "x-prohibited-field-names": ["name", "email", "phone", "address", "identity", "narrative", "free_text", "content", "text", "question", "prompt", "instruction", "consent", "answer", "response", "eligibility_outcome", "threshold", "cutoff", "weight", "score", "algorithm", "construct", "construct_name", "construct_description", "category_name", "label_text", "instrument", "item", "response_choice", "manual", "birth_time", "candidate_interval", "chart", "relationship", "mapping_hypothesis", "mapping_result", "astrology"],
