{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:humandesign:natal-time:a1-gpt-heavy:custody:v1",
  "title": "Closed conspicuously synthetic A1 GPT-heavy custody metadata",
