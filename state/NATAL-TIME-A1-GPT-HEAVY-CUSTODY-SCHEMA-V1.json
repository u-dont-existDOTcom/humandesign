          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SYN-A1G-(?:SRC|DRV)-[0-9]{4}$"}},
          "human_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SYN-A1G-SRC-[0-9]{4}$"}},
          "derivative_id": {"type": "string", "pattern": "^SYN-A1G-DRV-[0-9]{4}$"},
          "authority_state": {"enum": ["MECHANICAL_NONAUTHORITATIVE", "NONAUTHORITATIVE_PENDING_JOEL", "JOEL_ACCEPTED_SOURCE_LINKED"]},
          "decision_event_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^SYN-A1G-DEVT-[0-9]{4}$"}]},
          "occurred_after_raw_freeze": {"const": true},
          "original_source_preserved": {"const": true},
          "source_offsets": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["source_id", "start", "end", "unit"], "properties": {"source_id": {"type": "string", "pattern": "^SYN-A1G-SRC-[0-9]{4}$"}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}, "unit": {"enum": ["BYTE", "MILLISECOND", "TOKEN_INDEX"]}}}]},
          "timestamps_preserved": {"type": "boolean"},
          "uncertainty_preserved": {"type": "boolean"},
          "mechanical_meaning_change": {"const": false},
          "mechanical_hierarchy_change": {"const": false},
          "mechanical_grouping_change": {"const": false},
          "record_action": {"enum": ["PRESERVE_AND_DERIVE", "FLAG_ONLY_PRESERVE_ALL", "ACCEPTED_SOURCE_LINKED_DERIVATIVE", "COMPILE_ACCEPTED_UNITS_PRESERVE_CONFLICT"]},
