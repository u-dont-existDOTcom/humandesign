      "properties": {
        "evidence_packet": {"type": "object", "additionalProperties": false, "required": ["packet_id", "packet_sha256", "content_present"], "properties": {"packet_id": {"type": "string", "pattern": "^SYN-A1G-ADJ-PKT-[0-9]{4}$"}, "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "content_present": {"const": false}}},
        "access_events": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^SYN-A1G-ACCESS-[0-9]{4}$"}},
        "initial_slots": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["slot_id", "run_id", "context_id", "model_identity_state", "access_event_id", "output_id", "sealed_before_peer_access", "can_see_peer_unsealed_output"], "properties": {"slot_id": {"enum": ["GPT_INITIAL_RUN_SLOT_A", "GPT_INITIAL_RUN_SLOT_B"]}, "run_id": {"type": "string", "pattern": "^SYN-A1G-RUN-[AB]$"}, "context_id": {"type": "string", "pattern": "^SYN-A1G-CTX-[AB]$"}, "model_identity_state": {"const": "UNSELECTED"}, "access_event_id": {"type": "string", "pattern": "^SYN-A1G-ACCESS-[0-9]{4}$"}, "output_id": {"type": "string", "pattern": "^SYN-A1G-ADJ-OUT-[AB]$"}, "sealed_before_peer_access": {"const": true}, "can_see_peer_unsealed_output": {"const": false}}}},
        "outputs": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["output_id", "run_id", "packet_id", "sealed", "opaque_judgment_only"], "properties": {"output_id": {"type": "string", "pattern": "^SYN-A1G-ADJ-OUT-[AB]$"}, "run_id": {"type": "string", "pattern": "^SYN-A1G-RUN-[AB]$"}, "packet_id": {"type": "string", "pattern": "^SYN-A1G-ADJ-PKT-[0-9]{4}$"}, "sealed": {"const": true}, "opaque_judgment_only": {"const": true}}}},
        "reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["slot_id", "context_id", "input_output_ids", "output_id", "preserves_initial_outputs", "preserves_disagreement", "selected_rule"],
          "properties": {
            "slot_id": {"const": "GPT_RECONCILIATION_SLOT"},
            "context_id": {"const": "SYN-A1G-CTX-RECON"},
            "input_output_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^SYN-A1G-ADJ-OUT-[AB]$"}},
            "output_id": {"const": "SYN-A1G-ADJ-RECON-OUT"},
            "preserves_initial_outputs": {"const": true},
            "preserves_disagreement": {"const": true},
            "selected_rule": {"type": "null"}
